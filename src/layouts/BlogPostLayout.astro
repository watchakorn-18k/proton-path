---
import '../styles/global.css';
import ThemeSwitcher from '../components/ThemeSwitcher.astro';

const { frontmatter } = Astro.props;
const { title, description, date, tags, image, coords, name, nameEn, location, difficulty, walkDuration } = frontmatter;

// Prefix internal absolute paths with the deploy base (/proton-path)
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (p: string) => `${base}${p.startsWith('/') ? p : `/${p}`}`;
const heroImage = image ? withBase(image) : undefined;
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = heroImage && Astro.site ? new URL(heroImage, Astro.site).href : undefined;

// Google Maps directions link from the trail coordinates
const mapsUrl = coords
	? `https://www.google.com/maps/search/?api=1&query=${coords[0]},${coords[1]}`
	: undefined;

const dateFmt = new Intl.DateTimeFormat('th-TH', {
	day: 'numeric',
	month: 'long',
	year: 'numeric'
});
const formattedDate = date ? dateFmt.format(new Date(date)) : '';

const siteTitle = 'Proton Path';
const pageTitle = `${title} - ${siteTitle}`;
const metaDesc = description || title;

const jsonLd = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title,
	description: metaDesc,
	...(ogImage ? { image: ogImage } : {}),
	datePublished: date,
	author: {
		'@type': 'Person',
		name: 'Proton Path',
		url: Astro.site?.href
	},
	publisher: {
		'@type': 'Organization',
		name: siteTitle,
		url: Astro.site?.href
	},
	...(canonicalUrl ? { url: canonicalUrl, mainEntityOfPage: canonicalUrl } : {}),
	...(location ? { locationCreated: { '@type': 'Place', name: (nameEn || name) + ', ' + location + ', Thailand' } } : {})
});
---

<html lang="th">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

		<title>{pageTitle}</title>
		<meta name="description" content={metaDesc} />

		<meta property="og:type" content="article" />
		<meta property="og:site_name" content={siteTitle} />
		<meta property="og:locale" content="th_TH" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={metaDesc} />
		{canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
		{ogImage && <meta property="og:image" content={ogImage} />}
		{ogImage && <meta property="og:image:width" content="1080" />}
		{ogImage && <meta property="og:image:height" content="1080" />}
		{date && <meta property="article:published_time" content={new Date(date).toISOString()} />}

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={metaDesc} />
		{ogImage && <meta name="twitter:image" content={ogImage} />}

		<script type="application/ld+json" set:html={jsonLd} />
	</head>
	<body>
		<a class="skip-link" href="#content">ข้ามไปยังเนื้อหา</a>

		<header class="site-nav">
			<a class="brand-mark" href={withBase('/')} aria-label="Proton Path home">
				<span>Proton</span>
				<span>◄ Path</span>
			</a>
			<nav aria-label="Primary navigation">
				<a href={withBase('/#video')}>คลิปล่าสุด</a>
				<a href={withBase('/#route')}>เส้นทาง</a>
				<a href={withBase('/#about')}>เกี่ยวกับ</a>
				<a href={withBase('/blog/')}>บล็อก</a>
			</nav>
			<ThemeSwitcher />
		</header>

		<main id="content" class="blog-shell">
			{heroImage && (
				<div class="blog-hero">
					<img src={heroImage} alt={title} />
					<div class="blog-hero-shade"></div>
				</div>
			)}

			<article class="blog-article">
				<header class="blog-header">
					<a href={withBase('/blog/')} class="blog-back">← กลับหน้าบล็อก</a>
					<h1>{title}</h1>
					<div class="blog-meta">
						{formattedDate && <time datetime={date}>{formattedDate}</time>}
						{tags && tags.length > 0 && (
							<div class="blog-tags">
								{tags.map((tag: string) => (
									<span class="blog-tag">{tag}</span>
								))}
							</div>
						)}
					</div>
					{mapsUrl && (
						<a
							class="map-cta"
							href={mapsUrl}
							target="_blank"
							rel="noopener noreferrer"
						>
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="M20 10c0 4.4-8 12-8 12s-8-7.6-8-12a8 8 0 0 1 16 0Z"/>
								<circle cx="12" cy="10" r="3"/>
							</svg>
							<span>เปิดพิกัดใน Google Maps</span>
						</a>
					)}
				</header>

				<div class="blog-content">
					<slot />
				</div>
			</article>
		</main>

		<footer class="site-footer">
			<div>
				<strong>Proton Path</strong>
				<span>Thai trekking notes</span>
			</div>
			<nav aria-label="Footer navigation">
				<a href={withBase('/')}>หน้าแรก</a>
				<a href={withBase('/blog/')}>บล็อก</a>
			</nav>
			<p>© 2026 Proton Path. All rights reserved.</p>
		</footer>

		<script>
			import '../scripts/theme-switcher.ts';
		</script>
	</body>
</html>
