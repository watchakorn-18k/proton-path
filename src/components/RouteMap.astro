---
// Dynamic route map component - supports multiple trail points
export interface TrailPoint {
	id: number;
	name: string;
	nameEn: string;
	coords: [number, number];
	date?: string;
	walkDuration?: string;
	difficulty?: string;
	blogUrl: string;
}

interface Props {
	points?: TrailPoint[];
}

const { points = [] } = Astro.props;

// Serialize data for client-side script
const pointsData = JSON.stringify(points);
---

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<div class="route-map-container">
	<div id="route-map" class="route-map" data-points={pointsData}></div>
</div>

<script>
	import L from 'leaflet';

	function initMap() {
		try {
			const mapEl = document.getElementById('route-map');
			if (!mapEl) return;

			const pointsData = JSON.parse(mapEl.dataset.points || '[]');
			if (pointsData.length === 0) return;

			const formatDate = (date) => {
				if (!date) return '';
				const parsed = new Date(date);
				const day = String(parsed.getDate()).padStart(2, '0');
				const month = String(parsed.getMonth() + 1).padStart(2, '0');
				const year = parsed.getFullYear();
				return `${day}/${month}/${year}`;
			};

			// Center on first point or calculate bounds
			const firstPoint = pointsData[0];
			const map = L.map('route-map').setView(firstPoint.coords, 9);

			L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
				attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
				maxZoom: 19
			}).addTo(map);

			const tooltipMarkers: L.Marker[] = [];
			let tooltipsVisible = true;
			let metaHidden = false;

			// Difficulty → pin border colors only. All pins share the same dark fill.
			const pinBorderConfigs = [
				{ test: /ยากมาก/, border: '#e0564a' },
				{ test: /ยาก|ชัน/, border: '#e8954e' },
				{ test: /ปานกลาง/, border: '#e6c34d' },
				{ test: /ง่ายมาก/, border: '#5fb87a' },
				{ test: /ง่าย/, border: '#5fb87a' }
			];
			const defaultBorder = '#a8b879';
			const commonFill = 'var(--forest-900)';

			function getBorderForDifficulty(diff) {
				if (!diff) return defaultBorder;
				for (const cfg of pinBorderConfigs) {
					if (cfg.test.test(diff)) return cfg.border;
				}
				return defaultBorder;
			}

			// Create markers for each point
			pointsData.forEach((point) => {
				const border = getBorderForDifficulty(point.difficulty);
				const customIcon = L.divIcon({
					className: 'custom-pin',
					html: `<div class="pin-inner" data-number="${point.id}" style="background: ${commonFill}; border-color: ${border}; --pin-border: ${border};"></div>`,
					iconSize: [34, 34],
					iconAnchor: [17, 34]
				});

				const pointDate = formatDate(point.date);
				const metaParts = [point.nameEn, pointDate, point.walkDuration].filter(Boolean);
				const popupContent = `
					<div style="min-width: 180px;">
						<b>${point.name}</b><br>
						<small style="color: rgba(237, 231, 213, 0.7);">${metaParts.join(' · ')}</small><br>
						<a href="${point.blogUrl}" style="color: #a8b879; text-decoration: none; font-weight: 600; font-size: 0.9rem; display: inline-block; margin-top: 0.5rem;">
							อ่านเพิ่มเติม →
						</a>
					</div>
				`;
				const tooltipParts = [pointDate, point.walkDuration].filter(Boolean);
				const tooltipContent = `
					<div class="map-tooltip-card">
						<strong>${point.name}</strong>
						<span>${tooltipParts.join(' · ')}</span>
					</div>
				`;

				const marker = L.marker(point.coords, { icon: customIcon })
					.addTo(map)
					.bindTooltip(tooltipContent, {
						permanent: true,
						direction: 'top',
						offset: [0, -38],
						className: 'map-point-tooltip'
					})
					.bindPopup(popupContent);

				// Click a pin in a cluster → fly in for a closer look.
				marker.on('click', () => {
					map.flyTo(point.coords, 13, { duration: 0.8 });
				});

				tooltipMarkers.push(marker);
			});

			// Scale tooltip text with zoom: zoomed out = smaller, zoomed in = full size.
			// The var cascades onto the leaflet tooltip pane inside #route-map.
			const MIN_ZOOM = 6;   // most zoomed-out (overview) → smallest text
			const MAX_ZOOM = 11;  // zoomed in → full size
			const MIN_SCALE = 0.5;
			const updateLabelScale = () => {
				const z = map.getZoom();
				const t = Math.min(Math.max((z - MIN_ZOOM) / (MAX_ZOOM - MIN_ZOOM), 0), 1);
				const scale = MIN_SCALE + (1 - MIN_SCALE) * t;
				mapEl.style.setProperty('--label-scale', scale.toFixed(3));
			};
			map.on('zoom zoomend', updateLabelScale);

			// Fit bounds if multiple points
			let initialBounds: L.LatLngBounds | null = null;
			if (pointsData.length > 1) {
				initialBounds = L.latLngBounds(pointsData.map(p => p.coords));
				map.fitBounds(initialBounds, { padding: [50, 50] });
			}

			updateLabelScale();

			// Tooltip toggle toolbar (bottom-right)
			const svgLabelOn = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>';
			const svgLabelOff = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/><line x1="1" y1="1" x2="23" y2="23"></line></svg>';
			const svgNameOnly = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="9" x2="20" y2="9"></line><line x1="4" y1="15" x2="12" y2="15"></line></svg>';
			const svgReset = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 21 3 21 3 15"></polyline><polyline points="15 3 21 3 21 9"></polyline><line x1="21" y1="3" x2="14" y2="10"></line><line x1="3" y1="21" x2="10" y2="14"></line></svg>';

			const toolbar = document.createElement('div');
			toolbar.className = 'map-toolbar';
			toolbar.innerHTML = `
				${initialBounds ? `<button class="map-toolbar-btn" data-action="reset-view" title="กลับมุมมองรวม">${svgReset}<span>มุมรวม</span></button>` : ''}
				<button class="map-toolbar-btn" data-action="toggle-meta" title="แสดงเฉพาะชื่อทริป">
					${svgNameOnly}
					<span>เฉพาะชื่อ</span>
				</button>
				<button class="map-toolbar-btn active" data-action="toggle-tooltips" title="เปิด/ปิดข้อความบนแผนที่">
					${svgLabelOn}
					<span>ป้ายชื่อ</span>
				</button>
			`;
			mapEl.parentElement?.appendChild(toolbar);

			const toggleBtn = toolbar.querySelector('[data-action="toggle-tooltips"]');
			if (toggleBtn) {
				toggleBtn.addEventListener('click', () => {
					tooltipsVisible = !tooltipsVisible;
					tooltipMarkers.forEach((m) => {
						const tooltip = m.getTooltip();
						if (tooltip) {
							if (tooltipsVisible) {
								m.openTooltip();
							} else {
								m.closeTooltip();
							}
						}
					});
					toggleBtn.classList.toggle('active', tooltipsVisible);
					const svgEl = toggleBtn.querySelector('svg');
					if (svgEl) {
						svgEl.outerHTML = tooltipsVisible ? svgLabelOn : svgLabelOff;
					}
				});
			}

			// Toggle name-only mode: hides the date / walk-duration meta line.
			const metaBtn = toolbar.querySelector('[data-action="toggle-meta"]');
			if (metaBtn) {
				metaBtn.addEventListener('click', () => {
					metaHidden = !metaHidden;
					mapEl.parentElement?.classList.toggle('tooltips-name-only', metaHidden);
					metaBtn.classList.toggle('active', metaHidden);
				});
			}

			// Reset to the overview that fits all points.
			const resetBtn = toolbar.querySelector('[data-action="reset-view"]');
			if (resetBtn && initialBounds) {
				resetBtn.addEventListener('click', () => {
					map.flyToBounds(initialBounds, { padding: [50, 50], duration: 0.8 });
				});
			}

			// Difficulty colour legend (bottom-left)
			const legendItems = [
				{ color: '#e0564a', label: 'ยากมาก' },
				{ color: '#e8954e', label: 'ยาก / ชัน' },
				{ color: '#e6c34d', label: 'ปานกลาง' },
				{ color: '#5fb87a', label: 'ง่าย' }
			];
			const legend = document.createElement('div');
			legend.className = 'map-legend';
			legend.innerHTML = `
				<span class="map-legend-title">ระดับความยาก</span>
				${legendItems.map((it) => `
					<span class="map-legend-item">
						<span class="map-legend-dot" style="border-color: ${it.color};"></span>
						${it.label}
					</span>
				`).join('')}
			`;
			mapEl.parentElement?.appendChild(legend);

		} catch (error) {
			console.error('Map init error:', error);
		}
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initMap);
	} else {
		setTimeout(initMap, 100);
	}
</script>

<style>
	.route-map-container {
		position: relative;
		width: 100%;
		height: 50vh;
		border: 1px solid var(--line);
		border-radius: 0.5rem;
		background: rgb(13 26 19 / 0.76);
		backdrop-filter: blur(18px);
		overflow: hidden;
	}

	@media (min-width: 640px) {
		.route-map-container {
			height: min(72vh, 36rem);
		}
	}

	@media (min-width: 1024px) {
		.route-map-container {
			height: min(85vh, 52rem);
		}
	}

	.route-map {
		width: 100%;
		height: 100%;
	}

	/* Map Toolbar */
	:global(.map-toolbar) {
		position: absolute;
		bottom: 28px;
		right: 10px;
		z-index: 1000;
		display: flex;
		gap: 6px;
	}

	:global(.map-toolbar-btn) {
		display: flex;
		align-items: center;
		gap: 6px;
		padding: 6px 10px;
		background: rgb(13 26 19 / 0.9);
		border: 1px solid var(--line);
		border-radius: 0.375rem;
		color: var(--muted);
		font-family: var(--font-body);
		font-size: 0.75rem;
		font-weight: 700;
		cursor: pointer;
		backdrop-filter: blur(8px);
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
		transition: all 0.2s ease;
	}

	:global(.map-toolbar-btn svg) {
		stroke: var(--muted);
		transition: stroke 0.2s ease;
	}

	:global(.map-toolbar-btn:hover) {
		border-color: color-mix(in srgb, var(--moss) 50%, transparent);
		color: var(--bone);
		background: rgb(13 26 19 / 0.95);
	}

	:global(.map-toolbar-btn.active) {
		border-color: var(--moss);
		color: var(--moss);
		background: rgb(13 26 19 / 0.95);
	}

	:global(.map-toolbar-btn.active svg) {
		stroke: var(--moss);
	}

	/* Difficulty legend (bottom-left) */
	:global(.map-legend) {
		position: absolute;
		bottom: 28px;
		left: 10px;
		z-index: 1000;
		display: flex;
		flex-direction: column;
		gap: 4px;
		padding: 8px 10px;
		background: rgb(13 26 19 / 0.9);
		border: 1px solid var(--line);
		border-radius: 0.375rem;
		backdrop-filter: blur(8px);
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
	}

	:global(.map-legend-title) {
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.6rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	:global(.map-legend-item) {
		display: flex;
		align-items: center;
		gap: 6px;
		color: var(--bone);
		font-size: 0.7rem;
		font-weight: 600;
	}

	:global(.map-legend-dot) {
		width: 11px;
		height: 11px;
		border-radius: 50%;
		border: 2.5px solid var(--moss);
		background: var(--forest-900);
		flex-shrink: 0;
	}

	@media (max-width: 480px) {
		:global(.map-legend) {
			padding: 6px 8px;
		}
		:global(.map-legend-item) {
			font-size: 0.62rem;
		}
	}

	:global(.leaflet-container) {
		font-family: var(--font-body);
	}

	:global(.leaflet-popup-content-wrapper) {
		background: rgb(13 26 19 / 0.95) !important;
		color: var(--bone) !important;
		border: 1px solid var(--line) !important;
		border-radius: 0.375rem !important;
	}

	:global(.leaflet-popup-content) {
		margin: 0.75rem !important;
	}

	/* Custom pin styling - dynamic numbers */
	:global(.custom-pin) {
		background: transparent !important;
		border: none !important;
	}

	:global(.pin-inner) {
		position: relative;
		width: 34px;
		height: 34px;
		background: var(--forest-900);
		border: 2.5px solid var(--moss);
		border-radius: 50% 50% 50% 0;
		transform: rotate(-45deg) scale(var(--label-scale, 1));
		box-shadow: 0 4px 10px rgb(7 17 13 / 0.55);
		display: flex;
		align-items: center;
		justify-content: center;
		font-weight: 800;
		font-size: 0.95rem;
		color: var(--bone);
		font-family: var(--font-heading);
		cursor: pointer;
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}

	/* Dynamic number from data attribute */
	:global(.pin-inner::after) {
		content: attr(data-number);
		transform: rotate(45deg);
		display: block;
		color: var(--pin-border, var(--moss));
		text-shadow: 0 1px 2px rgb(7 17 13 / 0.6);
	}

	:global(.custom-pin:hover .pin-inner) {
		transform: rotate(-45deg) scale(calc(var(--label-scale, 1) * 1.12));
		box-shadow: 0 6px 16px rgb(7 17 13 / 0.7);
		z-index: 1000;
	}

	/* Always-visible map tooltip */
	:global(.map-point-tooltip) {
		border: 1px solid rgb(237 231 213 / 0.18) !important;
		border-radius: 0.375rem !important;
		background: rgb(13 26 19 / 0.92) !important;
		box-shadow: 0 6px 18px rgb(0 0 0 / 0.28) !important;
		color: var(--bone) !important;
		padding: 0 !important;
		backdrop-filter: blur(12px);
		transition: opacity 0.2s ease;
	}

	:global(.map-point-tooltip::before) {
		border-top-color: rgb(13 26 19 / 0.92) !important;
	}

	:global(.map-tooltip-card) {
		display: grid;
		gap: 0.15rem;
		padding: 0.45rem 0.65rem;
		min-width: 8rem;
		white-space: nowrap;
	}

	:global(.map-tooltip-card strong) {
		color: var(--bone);
		font-size: calc(0.8rem * var(--label-scale, 1));
		line-height: 1.25;
	}

	:global(.map-tooltip-card span) {
		color: var(--moss);
		font-family: var(--font-mono);
		font-size: calc(0.68rem * var(--label-scale, 1));
		font-weight: 700;
		letter-spacing: 0.04em;
	}

	/* Shrink padding alongside the text when zoomed out */
	:global(.map-tooltip-card) {
		padding: calc(0.45rem * var(--label-scale, 1)) calc(0.65rem * var(--label-scale, 1));
	}

	/* Name-only mode: hide the date / walk-duration line */
	:global(.tooltips-name-only .map-tooltip-card span) {
		display: none;
	}
</style>
