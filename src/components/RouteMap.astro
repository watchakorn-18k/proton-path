---
// Dynamic route map component - supports multiple trail points
export interface TrailPoint {
	id: number;
	name: string;
	nameEn: string;
	coords: [number, number];
	date?: string;
	walkDuration?: string;
	difficulty?: string;
	cost?: number;
	blogUrl: string;
}

interface Props {
	points?: TrailPoint[];
}

const { points = [] } = Astro.props;

// Serialize data for client-side script
const pointsData = JSON.stringify(points);
---

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<div class="route-map-container">
	<div id="route-map" class="route-map" data-points={pointsData}></div>
</div>

<script>
	import L from 'leaflet';

	function initMap() {
		try {
			const mapEl = document.getElementById('route-map');
			if (!mapEl) return;

			const pointsData = JSON.parse(mapEl.dataset.points || '[]');
			if (pointsData.length === 0) return;

			const formatDate = (date) => {
				if (!date) return '';
				const parsed = new Date(date);
				const day = String(parsed.getDate()).padStart(2, '0');
				const month = String(parsed.getMonth() + 1).padStart(2, '0');
				const year = parsed.getFullYear();
				return `${day}/${month}/${year}`;
			};

			// Center on first point or calculate bounds
			const firstPoint = pointsData[0];
			const map = L.map('route-map').setView(firstPoint.coords, 9);

			const streetLayer = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
				attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
				maxZoom: 19
			}).addTo(map);

			// Esri World Imagery for the satellite toggle — shows real terrain / ridgelines.
			const satelliteLayer = L.tileLayer(
				'https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}',
				{
					attribution: 'Tiles &copy; Esri &mdash; Source: Esri, Maxar, Earthstar Geographics',
					maxZoom: 19
				}
			);

			const tooltipMarkers: L.Marker[] = [];
			let tooltipsVisible = true;
			let metaHidden = false;
			let satelliteActive = false;

			// Difficulty → pin border colors only. All pins share the same dark fill.
			const pinBorderConfigs = [
				{ test: /ยากมาก/, border: '#e0564a' },
				{ test: /ยาก|ชัน/, border: '#e8954e' },
				{ test: /ปานกลาง/, border: '#e6c34d' },
				{ test: /ง่ายมาก/, border: '#5fb87a' },
				{ test: /ง่าย/, border: '#5fb87a' }
			];
			const defaultBorder = '#a8b879';
			const commonFill = 'var(--forest-900)';

			function getBorderForDifficulty(diff) {
				if (!diff) return defaultBorder;
				for (const cfg of pinBorderConfigs) {
					if (cfg.test.test(diff)) return cfg.border;
				}
				return defaultBorder;
			}

			// Create markers for each point
			pointsData.forEach((point) => {
				const border = getBorderForDifficulty(point.difficulty);
				const customIcon = L.divIcon({
					className: 'custom-pin',
					html: `<div class="pin-inner" data-number="${point.id}" style="background: ${commonFill}; border-color: ${border}; --pin-border: ${border};"></div>`,
					iconSize: [34, 34],
					iconAnchor: [17, 34]
				});

				const pointDate = formatDate(point.date);
				const metaParts = [point.nameEn, pointDate].filter(Boolean);
				const stats = [
					point.difficulty ? { label: 'ความยาก', value: point.difficulty } : null,
					point.walkDuration ? { label: 'ระยะเวลา', value: point.walkDuration } : null,
					point.cost ? { label: 'ค่าใช้จ่าย', value: `~${point.cost.toLocaleString()} ฿` } : null
				].filter(Boolean);
				const statsHtml = stats.length
					? `<div class="map-popup-stats">${stats.map((s) => `
							<div class="map-popup-stat">
								<span class="map-popup-stat-label">${s.label}</span>
								<strong class="map-popup-stat-value">${s.value}</strong>
							</div>
						`).join('')}</div>`
					: '';
				const popupContent = `
					<div class="map-popup" style="min-width: 200px;">
						<b>${point.name}</b><br>
						<small style="color: rgba(237, 231, 213, 0.7);">${metaParts.join(' · ')}</small>
						${statsHtml}
						<a href="${point.blogUrl}" style="color: #a8b879; text-decoration: none; font-weight: 600; font-size: 0.9rem; display: inline-block; margin-top: 0.5rem;">
							อ่านเพิ่มเติม →
						</a>
					</div>
				`;
				const tooltipParts = [pointDate, point.walkDuration].filter(Boolean);
				const tooltipContent = `
					<div class="map-tooltip-card">
						<strong>${point.name}</strong>
						<span>${tooltipParts.join(' · ')}</span>
					</div>
				`;

				const marker = L.marker(point.coords, { icon: customIcon })
					.addTo(map)
					.bindTooltip(tooltipContent, {
						permanent: true,
						direction: 'top',
						offset: [0, -38],
						className: 'map-point-tooltip'
					})
					.bindPopup(popupContent);

				// Click a pin in a cluster → fly in for a closer look.
				marker.on('click', () => {
					map.flyTo(point.coords, 13, { duration: 0.8 });
				});

				tooltipMarkers.push(marker);
			});

			// Travel-order route line, connecting points by id (1 → 2 → 3 ...).
			// Built but kept off the map until toggled on.
			const orderedCoords = [...pointsData]
				.sort((a, b) => a.id - b.id)
				.map((p) => p.coords);
			const routeLine = L.polyline(orderedCoords, {
				color: '#ff6b6b',
				weight: 2.5,
				opacity: 0.95,
				dashArray: '7 8',
				lineCap: 'round',
				lineJoin: 'round'
			});
			let routeVisible = false;

			// Walking icon that moves along the route path.
			// Walks segment-by-segment (1→2→3...→last), pauses, then snaps back to 1 and restarts.
			const walkerIcon = L.divIcon({
				className: 'route-walker-icon',
				html: '🥾',
				iconSize: [22, 22],
				iconAnchor: [11, 11]
			});
			const walkerMarker = L.marker(orderedCoords[0], {
				icon: walkerIcon,
				interactive: false,
				zIndexOffset: 1000
			});
			let walkerAnimId: number | null = null;

			const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

			const SEGMENT_DURATION = 6000; // ms per segment — real walking pace, no rush
			const PAUSE_AT_END = 5000;     // ms rest at last point before heading back

			function startRouteAnim() {
				if (prefersReducedMotion || orderedCoords.length < 2) return;
				const segCount = orderedCoords.length - 1;
				const cycleDuration = segCount * SEGMENT_DURATION + PAUSE_AT_END;
				const startTime = performance.now();

				function step(now: number) {
					if (!routeVisible) return;
					const elapsed = (now - startTime) % cycleDuration;
					if (elapsed >= segCount * SEGMENT_DURATION) {
						// Pausing at last point — stay put.
						walkerMarker.setLatLng(orderedCoords[orderedCoords.length - 1]);
					} else {
						const segIndex = Math.min(Math.floor(elapsed / SEGMENT_DURATION), segCount - 1);
						const segT = (elapsed - segIndex * SEGMENT_DURATION) / SEGMENT_DURATION;
						const from = orderedCoords[segIndex];
						const to = orderedCoords[segIndex + 1];
						const lat = from[0] + (to[0] - from[0]) * segT;
						const lng = from[1] + (to[1] - from[1]) * segT;
						walkerMarker.setLatLng([lat, lng]);
					}
					// Snap back to point 1 at the very start of each cycle.
					const cycleElapsed = (now - startTime) % cycleDuration;
					if (cycleElapsed < 16) {
						walkerMarker.setLatLng(orderedCoords[0]);
					}
					walkerAnimId = requestAnimationFrame(step);
				}
				// Defer to let polyline SVG render.
				setTimeout(() => { walkerAnimId = requestAnimationFrame(step); }, 120);
			}

			function stopRouteAnim() {
				if (walkerAnimId) { cancelAnimationFrame(walkerAnimId); walkerAnimId = null; }
			}

			// Scale tooltip text with zoom: zoomed out = smaller, zoomed in = full size.
			// The var cascades onto the leaflet tooltip pane inside #route-map.
			const MIN_ZOOM = 6;   // most zoomed-out (overview) → smallest text
			const MAX_ZOOM = 11;  // zoomed in → full size
			const MIN_SCALE = 0.5;
			const updateLabelScale = () => {
				const z = map.getZoom();
				const t = Math.min(Math.max((z - MIN_ZOOM) / (MAX_ZOOM - MIN_ZOOM), 0), 1);
				const scale = MIN_SCALE + (1 - MIN_SCALE) * t;
				mapEl.style.setProperty('--label-scale', scale.toFixed(3));
			};
			map.on('zoom zoomend', updateLabelScale);

			// Fit bounds if multiple points
			let initialBounds: L.LatLngBounds | null = null;
			if (pointsData.length > 1) {
				initialBounds = L.latLngBounds(pointsData.map(p => p.coords));
				map.fitBounds(initialBounds, { padding: [50, 50] });
			}

			updateLabelScale();

			// Tooltip toggle toolbar (bottom-right)
			const svgLabelOn = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>';
			const svgLabelOff = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/><line x1="1" y1="1" x2="23" y2="23"></line></svg>';
			const svgNameOnly = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="9" x2="20" y2="9"></line><line x1="4" y1="15" x2="12" y2="15"></line></svg>';
			const svgReset = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 21 3 21 3 15"></polyline><polyline points="15 3 21 3 21 9"></polyline><line x1="21" y1="3" x2="14" y2="10"></line><line x1="3" y1="21" x2="10" y2="14"></line></svg>';
			const svgSatellite = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>';
			const svgFsOpen = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H5a2 2 0 0 0-2 2v3"></path><path d="M21 8V5a2 2 0 0 0-2-2h-3"></path><path d="M3 16v3a2 2 0 0 0 2 2h3"></path><path d="M16 21h3a2 2 0 0 0 2-2v-3"></path></svg>';
			const svgFsClose = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3v3a2 2 0 0 1-2 2H3"></path><path d="M21 8h-3a2 2 0 0 1-2-2V3"></path><path d="M3 16h3a2 2 0 0 1 2 2v3"></path><path d="M16 21v-3a2 2 0 0 1 2-2h3"></path></svg>';
			const svgGear = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>';
			const svgRoute = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="19" r="3"></circle><path d="M9 19h8.5a3.5 3.5 0 0 0 0-7h-11a3.5 3.5 0 0 1 0-7H15"></path><circle cx="18" cy="5" r="3"></circle></svg>';

			const toolbar = document.createElement('div');
			toolbar.className = 'map-toolbar';
			toolbar.innerHTML = `
				<button class="map-toolbar-trigger" data-action="toggle-menu" title="เครื่องมือแผนที่" aria-expanded="false">
					${svgGear}
					<span>เครื่องมือ</span>
				</button>
				<div class="map-toolbar-menu">
					<button class="map-toolbar-btn" data-action="toggle-fullscreen" title="ดูแบบเต็มจอ">${svgFsOpen}<span>เต็มจอ</span></button>
					<button class="map-toolbar-btn" data-action="toggle-satellite" title="สลับภาพถ่ายดาวเทียม">${svgSatellite}<span>ดาวเทียม</span></button>
					${orderedCoords.length > 1 ? `<button class="map-toolbar-btn" data-action="toggle-route" title="แสดงเส้นลำดับการเดินทาง">${svgRoute}<span>เส้นทาง</span></button>` : ''}
					${initialBounds ? `<button class="map-toolbar-btn" data-action="reset-view" title="กลับมุมมองรวม">${svgReset}<span>มุมรวม</span></button>` : ''}
					<button class="map-toolbar-btn" data-action="toggle-meta" title="แสดงเฉพาะชื่อทริป">
						${svgNameOnly}
						<span>เฉพาะชื่อ</span>
					</button>
					<button class="map-toolbar-btn active" data-action="toggle-tooltips" title="เปิด/ปิดข้อความบนแผนที่">
						${svgLabelOn}
						<span>ป้ายชื่อ</span>
					</button>
				</div>
			`;
			mapEl.parentElement?.appendChild(toolbar);

			// Dropdown open/close
			const triggerBtn = toolbar.querySelector('[data-action="toggle-menu"]');
			if (triggerBtn) {
				triggerBtn.addEventListener('click', (e) => {
					e.stopPropagation();
					const open = toolbar.classList.toggle('open');
					triggerBtn.setAttribute('aria-expanded', String(open));
				});
				document.addEventListener('click', (e) => {
					if (!toolbar.contains(e.target as Node)) {
						toolbar.classList.remove('open');
						triggerBtn.setAttribute('aria-expanded', 'false');
					}
				});
			}

			const toggleBtn = toolbar.querySelector('[data-action="toggle-tooltips"]');
			if (toggleBtn) {
				toggleBtn.addEventListener('click', () => {
					tooltipsVisible = !tooltipsVisible;
					tooltipMarkers.forEach((m) => {
						const tooltip = m.getTooltip();
						if (tooltip) {
							if (tooltipsVisible) {
								m.openTooltip();
							} else {
								m.closeTooltip();
							}
						}
					});
					toggleBtn.classList.toggle('active', tooltipsVisible);
					const svgEl = toggleBtn.querySelector('svg');
					if (svgEl) {
						svgEl.outerHTML = tooltipsVisible ? svgLabelOn : svgLabelOff;
					}
				});
			}

			// Toggle name-only mode: hides the date / walk-duration meta line.
			const metaBtn = toolbar.querySelector('[data-action="toggle-meta"]');
			if (metaBtn) {
				metaBtn.addEventListener('click', () => {
					metaHidden = !metaHidden;
					mapEl.parentElement?.classList.toggle('tooltips-name-only', metaHidden);
					metaBtn.classList.toggle('active', metaHidden);
				});
			}

			// Reset to the overview that fits all points.
			const resetBtn = toolbar.querySelector('[data-action="reset-view"]');
			if (resetBtn && initialBounds) {
				resetBtn.addEventListener('click', () => {
					map.flyToBounds(initialBounds, { padding: [50, 50], duration: 0.8 });
				});
			}

			// Toggle the travel-order route line + walking animation.
			const routeBtn = toolbar.querySelector('[data-action="toggle-route"]');
			if (routeBtn) {
				routeBtn.addEventListener('click', () => {
					routeVisible = !routeVisible;
					if (routeVisible) {
						routeLine.addTo(map);
						walkerMarker.addTo(map);
						startRouteAnim();
					} else {
						stopRouteAnim();
						map.removeLayer(walkerMarker);
						map.removeLayer(routeLine);
					}
					routeBtn.classList.toggle('active', routeVisible);
				});
			}

			// Toggle satellite imagery.
			const satBtn = toolbar.querySelector('[data-action="toggle-satellite"]');
			if (satBtn) {
				satBtn.addEventListener('click', () => {
					satelliteActive = !satelliteActive;
					if (satelliteActive) {
						map.removeLayer(streetLayer);
						satelliteLayer.addTo(map);
					} else {
						map.removeLayer(satelliteLayer);
						streetLayer.addTo(map);
					}
					mapEl.parentElement?.classList.toggle('map-satellite', satelliteActive);
					satBtn.classList.toggle('active', satelliteActive);
				});
			}

			// Toggle fullscreen on the map container.
			const fsBtn = toolbar.querySelector('[data-action="toggle-fullscreen"]');
			const container = mapEl.parentElement;
			if (fsBtn && container) {
				fsBtn.addEventListener('click', () => {
					if (!document.fullscreenElement) {
						container.requestFullscreen?.();
					} else {
						document.exitFullscreen?.();
					}
				});
				document.addEventListener('fullscreenchange', () => {
					const active = document.fullscreenElement === container;
					fsBtn.classList.toggle('active', active);
					const svgEl = fsBtn.querySelector('svg');
					if (svgEl) svgEl.outerHTML = active ? svgFsClose : svgFsOpen;
					// Leaflet needs a resize nudge after the box changes size.
					setTimeout(() => map.invalidateSize(), 120);
				});
			}

			// Difficulty colour legend (bottom-left)
			const legendItems = [
				{ color: '#e0564a', label: 'ยากมาก' },
				{ color: '#e8954e', label: 'ยาก / ชัน' },
				{ color: '#e6c34d', label: 'ปานกลาง' },
				{ color: '#5fb87a', label: 'ง่าย' }
			];
			const legend = document.createElement('div');
			legend.className = 'map-legend';
			legend.innerHTML = `
				<span class="map-legend-title">ระดับความยาก</span>
				${legendItems.map((it) => `
					<span class="map-legend-item">
						<span class="map-legend-dot" style="border-color: ${it.color};"></span>
						${it.label}
					</span>
				`).join('')}
			`;
			mapEl.parentElement?.appendChild(legend);

		} catch (error) {
			console.error('Map init error:', error);
		}
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initMap);
	} else {
		setTimeout(initMap, 100);
	}
</script>

<style>
	.route-map-container {
		position: relative;
		width: 100%;
		height: 50vh;
		border: 1px solid var(--line);
		border-radius: 0.5rem;
		background: rgb(13 26 19 / 0.76);
		backdrop-filter: blur(18px);
		overflow: hidden;
	}

	/* Fullscreen: fill the screen, drop the rounded frame */
	.route-map-container:fullscreen {
		width: 100%;
		height: 100%;
		border: none;
		border-radius: 0;
	}

	@media (min-width: 640px) {
		.route-map-container {
			height: min(72vh, 36rem);
		}
	}

	@media (min-width: 1024px) {
		.route-map-container {
			height: min(85vh, 52rem);
		}
	}

	.route-map {
		width: 100%;
		height: 100%;
	}

	/* Map Toolbar — dropdown */
	:global(.map-toolbar) {
		position: absolute;
		bottom: 28px;
		right: 10px;
		z-index: 1000;
		display: flex;
		flex-direction: column-reverse;
		align-items: flex-end;
		gap: 6px;
	}

	:global(.map-toolbar-trigger),
	:global(.map-toolbar-btn) {
		display: flex;
		align-items: center;
		gap: 6px;
		padding: 6px 10px;
		background: rgb(13 26 19 / 0.9);
		border: 1px solid var(--line);
		border-radius: 0.375rem;
		color: var(--muted);
		font-family: var(--font-body);
		font-size: 0.75rem;
		font-weight: 700;
		cursor: pointer;
		backdrop-filter: blur(8px);
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
		transition: all 0.2s ease;
		white-space: nowrap;
	}

	:global(.map-toolbar-trigger svg),
	:global(.map-toolbar-btn svg) {
		stroke: var(--muted);
		transition: stroke 0.2s ease;
	}

	:global(.map-toolbar-trigger:hover),
	:global(.map-toolbar-btn:hover) {
		border-color: color-mix(in srgb, var(--moss) 50%, transparent);
		color: var(--bone);
		background: rgb(13 26 19 / 0.95);
	}

	:global(.map-toolbar.open .map-toolbar-trigger) {
		border-color: var(--moss);
		color: var(--moss);
	}

	:global(.map-toolbar.open .map-toolbar-trigger svg) {
		stroke: var(--moss);
	}

	:global(.map-toolbar-btn.active) {
		border-color: var(--moss);
		color: var(--moss);
		background: rgb(13 26 19 / 0.95);
	}

	:global(.map-toolbar-btn.active svg) {
		stroke: var(--moss);
	}

	/* Collapsed menu: hidden until .open */
	:global(.map-toolbar-menu) {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 6px;
