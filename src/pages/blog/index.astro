---
import '../../styles/global.css';
import ThemeSwitcher from '../../components/ThemeSwitcher.astro';
import { getCollection } from 'astro:content';

// Prefix internal absolute paths with the deploy base (/proton-path)
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (p) => `${base}${p.startsWith('/') ? p : `/${p}`}`;

const youtubeUrl = 'https://www.youtube.com/@proton-path';
const posts = (await getCollection('blog'))
	.map((post) => ({
		slug: post.id,
		...post.data,
	}))
	.sort((a, b) => a.id - b.id);

const dateFmt = new Intl.DateTimeFormat('th-TH', {
	day: 'numeric',
	month: 'short',
	year: 'numeric'
});

const timelinePosts = [...posts].sort((a, b) => new Date(a.date).getTime() - new Date(b.date).getTime());
const tlMin = new Date(timelinePosts[0].date).getTime();
const tlMax = new Date(timelinePosts[timelinePosts.length - 1].date).getTime();
const tlRange = tlMax - tlMin || 1;
const tlPct = (d) => ((new Date(d).getTime() - tlMin) / tlRange * 100).toFixed(2);
const tlMinYear = new Date(timelinePosts[0].date).getFullYear();
const tlYearMarkers = [];
for (let y = tlMinYear + 1; y <= new Date(timelinePosts[timelinePosts.length - 1].date).getFullYear(); y++) {
	const pct = ((new Date(`${y}-01-01`).getTime() - tlMin) / tlRange * 100).toFixed(2);
	if (parseFloat(pct) > 5) tlYearMarkers.push({ year: y, pct });
}
const tlDiffColor = {
	'ยากมาก': '#e05252',
	'ยาก': '#d4845a',
	'ปานกลาง': '#a8b879',
	'ง่าย': '#8cc5a0',
	'ง่ายมาก': '#7ab8d6',
};
const tlDiffLabels = ['ยากมาก', 'ยาก', 'ปานกลาง', 'ง่าย', 'ง่ายมาก'];
---

<html lang="th">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="บันทึกเส้นทางเดินป่า trekking และ outdoor ในประเทศไทย" />
		<meta property="og:title" content="บล็อก - Proton Path" />
		<meta property="og:description" content="บันทึกเส้นทางเดินป่า trekking และ outdoor ในประเทศไทย" />
		<title>บล็อก - Proton Path</title>
	</head>
	<body>
		<a class="skip-link" href="#content">ข้ามไปยังเนื้อหา</a>

		<header class="site-nav">
			<a class="brand-mark" href={withBase('/')} aria-label="Proton Path home">
				<span>Proton</span>
				<span>◄ Path</span>
			</a>
			<nav aria-label="Primary navigation">
				<a href={withBase('/#video')}>คลิปล่าสุด</a>
				<a href={withBase('/#route')}>เส้นทาง</a>
				<a href={withBase('/#about')}>เกี่ยวกับ</a>
				<a href={withBase('/blog/')} class="active">บล็อก</a>
				<a href={withBase('/gear/')}>อุปกรณ์</a>
				<a href={youtubeUrl} target="_blank" rel="noopener noreferrer">YouTube</a>
			</nav>
			<ThemeSwitcher />
		</header>

		<main id="content" class="blog-index">
			<div class="blog-index-header">
				<p class="section-kicker">Thai trekking archive</p>
				<h1>บันทึกเส้นทาง</h1>
				<p class="blog-index-lede">
					เรื่องเล่าจากป่า เส้นทาง และการเดินทางที่บันทึกไว้เพื่อให้ผู้ที่สนใจได้อ่านและเตรียมตัว
				</p>
			</div>

			<div class="trail-timeline">
				<div class="trail-timeline-track">
					<div class="tl-line" />
					<span class="tl-year" style="left:0;transform:translate(0,-50%)">{tlMinYear}</span>
					{tlYearMarkers.map(({ year, pct }) => (
						<span class="tl-year" style={`left:${pct}%`}>{year}</span>
					))}
					{timelinePosts.map((post, i) => (
						<a
							href={withBase(`/blog/${post.slug}/`)}
							class={`tl-dot ${i % 2 === 0 ? 'above' : 'below'}`}
							style={`left:${tlPct(post.date)}%`}
							title={`${post.name} — ${dateFmt.format(new Date(post.date))}`}
						>
							<span class="tl-upper">
								<span class="tl-lbl">{i % 2 === 0 ? post.name : ''}</span>
							</span>
							<span class="tl-mark" style={`background:${tlDiffColor[post.difficulty] ?? '#a8b879'}`} />
							<span class="tl-lower">
								<span class="tl-lbl">{i % 2 !== 0 ? post.name : ''}</span>
							</span>
						</a>
					))}
				</div>
				<div class="tl-legend">
					{tlDiffLabels.map(d => (
						<span class="tl-legend-item">
							<span class="tl-legend-mark" style={`background:${tlDiffColor[d]}`} />
							{d}
						</span>
					))}
				</div>
			</div>

			<div class="blog-grid">
				{posts.map((post) => (
					<a href={withBase(`/blog/${post.slug}/`)} class="blog-card">
						<img src={withBase(post.image)} alt={post.title} />
						<div class="blog-card-content">
							<div class="blog-card-meta">
								<time datetime={post.date}>
									{dateFmt.format(new Date(post.date))}
								</time>
								<div class="blog-card-tags">
									{post.tags.map((tag) => (
										<span>{tag}</span>
									))}
								</div>
							</div>
							<p class="trail-number">NO.{post.id}</p>
							<h2>{post.title}</h2>
							<p>{post.description}</p>
						</div>
					</a>
				))}
			</div>
		</main>

		<footer class="site-footer">
			<div>
				<strong>Proton Path</strong>
				<span>Thai trekking notes</span>
			</div>
			<nav aria-label="Footer navigation">
				<a href={withBase('/')}>หน้าแรก</a>
				<a href={youtubeUrl} target="_blank" rel="noopener noreferrer">YouTube</a>
			</nav>
			<p>© 2026 Proton Path. All rights reserved.</p>
		</footer>

		<script>
			import '../../scripts/theme-switcher.ts';
		</script>
	</body>
</html>
