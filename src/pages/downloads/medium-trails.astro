---
import '../../styles/global.css';
import ThemeSwitcher from '../../components/ThemeSwitcher.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (p: string) => `${base}${p.startsWith('/') ? p : `/${p}`}`;

const dateFmt = new Intl.DateTimeFormat('th-TH', {
	day: 'numeric',
	month: 'short',
	year: 'numeric'
});

const generatedFmt = new Intl.DateTimeFormat('th-TH', {
	day: 'numeric',
	month: 'long',
	year: 'numeric'
});

const mediumTrails = (await getCollection('blog'))
	.map((post) => ({
		slug: post.id,
		...post.data,
	}))
	.filter((post) => post.difficulty === 'ปานกลาง')
	.sort((a, b) => a.id - b.id);

const generatedDate = generatedFmt.format(new Date());
const homepageUrl = withBase('/');
const blogUrl = withBase('/blog/');
const youtubeUrl = 'https://www.youtube.com/@proton-path';
const formatCoords = (coords: [number, number]) => coords.map((coord) => coord.toFixed(5)).join(', ');
const formatCost = (cost?: number) => (typeof cost === 'number' ? `${cost.toLocaleString('th-TH')} บาท` : '-');
---

<html lang="th">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="PDF สรุปเส้นทางเดินป่าระดับปานกลางจาก Proton Path" />
		<title>PDF เส้นทางระดับปานกลาง - Proton Path</title>
	</head>
	<body class="pdf-page">
		<header class="site-nav pdf-site-nav">
			<a class="brand-mark" href={homepageUrl} aria-label="Proton Path home">
				<span>Proton</span>
				<span>◄ Path</span>
			</a>
			<nav aria-label="Primary navigation">
				<a href={homepageUrl}>หน้าแรก</a>
				<a href={blogUrl}>บล็อก</a>
				<a href={youtubeUrl} target="_blank" rel="noopener noreferrer">YouTube</a>
			</nav>
			<ThemeSwitcher />
		</header>

		<main class="pdf-shell">
			<div class="pdf-action-bar">
				<a class="text-cta" href={homepageUrl}>← กลับหน้าแรก</a>
				<button type="button" class="primary-cta compact pdf-download-button" data-download-pdf>
					ดาวน์โหลด PDF ระดับปานกลาง
				</button>
			</div>

			<section class="pdf-document" data-pdf-document>
				<header class="pdf-document-header">
					<p class="section-kicker">Official trail summary</p>
					<div>
						<h1>สรุปเส้นทางเดินป่าระดับปานกลาง</h1>
						<p>Proton Path</p>
					</div>
					<ul>
						<li><span>จัดทำโดย</span><strong>Watchakorn Buddeewong (Proton)</strong></li>
						<li><span>อัปเดตข้อมูล</span><strong>{generatedDate}</strong></li>
						<li><span>แหล่งข้อมูล</span><strong>บล็อก Proton Path</strong></li>
					</ul>
				</header>

				<div class="pdf-summary-grid">
					<div>
						<span>จำนวนเส้นทาง</span>
						<strong>{mediumTrails.length}</strong>
						<small>ระดับปานกลาง</small>
					</div>
					<div>
						<span>รูปแบบข้อมูล</span>
						<strong>Dynamic</strong>
						<small>ดึงจาก content collection</small>
					</div>
					<div>
						<span>เหมาะสำหรับ</span>
						<strong>เตรียมตัวเดินป่า</strong>
						<small>อ่านภาพรวมก่อนเลือกเส้นทาง</small>
					</div>
				</div>

				<section class="pdf-trail-section" aria-label="Medium difficulty trails">
					<h2>รายการเส้นทาง</h2>
					{mediumTrails.length > 0 ? (
						<div class="pdf-trail-list">
							{mediumTrails.map((trail) => (
								<article class="pdf-trail-card">
									<div class="pdf-trail-image-wrapper">
										<img class="pdf-trail-image" src={withBase(trail.image)} alt={trail.name} />
										<div class="pdf-trail-number">NO.{String(trail.id).padStart(2, '0')}</div>
									</div>
									<div class="pdf-trail-body">
										<div class="pdf-trail-title-row">
											<div>
												<h3>{trail.name}</h3>
												<p>{trail.nameEn}</p>
											</div>
											<span class="pdf-trail-badge">{trail.difficulty}</span>
										</div>
										<dl class="pdf-trail-meta">
											<div>
												<dt>พื้นที่</dt>
												<dd>{trail.location}</dd>
											</div>
											<div>
												<dt>วันที่บันทึก</dt>
												<dd>{dateFmt.format(new Date(trail.date))}</dd>
											</div>
																																	<div class="">
												<dt>พิกัด</dt>
												<dd>{formatCoords(trail.coords)}</dd>
											</div>
										</dl>
										<p class="pdf-trail-description">{trail.description}</p>
									</div>
								</article>
							))}
						</div>
					) : (
						<p class="pdf-empty-state">ยังไม่มีบันทึกเส้นทางระดับปานกลางในระบบ</p>
					)}
				</section>

				<footer class="pdf-document-footer">
					<p>ข้อมูลนี้สร้างจากบล็อก Proton Path แบบ dynamic เมื่อมีเส้นทางระดับปานกลางเพิ่ม รายการจะอัปเดตอัตโนมัติในการ build ครั้งถัดไป</p>
					<strong>proton-path / medium trail summary</strong>
				</footer>
			</section>
		</main>

		<script>
			import '../../scripts/theme-switcher.ts';
			import '../../scripts/download-medium-trails-pdf.ts';
		</script>
	</body>
</html>
