  scRU.position.set( 0.35, 0.88, 0)
  // side compression strap L (lower)
  const scLL = box(0.045, 0.32, 0.055, SIL, 14)
  scLL.position.set(-0.35, 0.38, 0)
  // side compression strap R (lower)
  const scRL = box(0.045, 0.32, 0.055, SIL, 14)
  scRL.position.set( 0.35, 0.38, 0)

  // shoulder strap L
  const strL = box(0.13, 0.82, 0.085, DBLK, 10)
  strL.position.set(-0.35, 0.78, 0.12)
  strL.rotation.z =  0.17
  strL.rotation.x = -0.13

  // shoulder strap R
  const strR = box(0.13, 0.82, 0.085, DBLK, 10)
  strR.position.set( 0.35, 0.78, 0.12)
  strR.rotation.z = -0.17
  strR.rotation.x = -0.13

  // hip belt L
  const hipL = box(0.15, 0.12, 0.30, DBLK, 10)
  hipL.position.set(-0.40, 0.11, 0.07)
  hipL.rotation.y = 0.45
  // hip belt R
  const hipR = box(0.15, 0.12, 0.30, DBLK, 10)
  hipR.position.set( 0.40, 0.11, 0.07)
  hipR.rotation.y = -0.45

  // hip buckle L/R (gold — Naturehike signature colour)
  const buckL = box(0.08, 0.08, 0.045, GOLD, 32)
  buckL.position.set(-0.27, 0.11, 0.22)
  const buckR = box(0.08, 0.08, 0.045, GOLD, 32)
  buckR.position.set( 0.27, 0.11, 0.22)

  // sternum strap
  const sternum = box(0.30, 0.04, 0.045, SIL, 18)
  sternum.position.set(0, 0.90, 0.20)

  // top handle
  const handle = box(0.19, 0.08, 0.065, DBLK, 12)
  handle.position.set(0, 1.54, 0)

  g.add(
    body, lower, lid, lidCon,
    frameL, frameR,
    xL1, xR1, hMid, hLow, crossBuck,
    scLU, scRU, scLL, scRL,
    strL, strR,
    hipL, hipR, buckL, buckR,
    sternum, handle,
  )
  return g
}

// PLACE ITEMS
// ─────────────────────────────────────────────────────────────
const CREATORS = [
  createBackpack, createTent, createBottle, createHeadlamp,
  createPoles, createSleepingBag, createJacket, createWatch,
  createNaturehike,
]

const BASE_POS = [
  new THREE.Vector3(-3.0, 0.60, -1.2),  // Gregory — hanging
  new THREE.Vector3(-1.0, 0,    -1.2),
  new THREE.Vector3( 1.0, 0,    -1.2),
  new THREE.Vector3( 3.0, 0,    -1.2),
  new THREE.Vector3(-3.0, 0,     1.2),
  new THREE.Vector3(-1.0, 0,     1.2),
  new THREE.Vector3( 1.0, 0,     1.2),
  new THREE.Vector3( 3.0, 0,     1.2),
  new THREE.Vector3(-5.0, 0.56, -1.2),  // Naturehike — hanging
]

const itemGroups = CREATORS.map((create, i) => {
  const g = create()
  addEdges(g)
  g.traverse(c => {
    if (c.isMesh) {
      c.castShadow = true; c.receiveShadow = true
      c.userData.group = g
    }
  })
  g.position.copy(BASE_POS[i])
  g.userData.index    = i
  g.userData.floatPh  = i * (Math.PI * 2 / 9)
  g.userData.scaleTarget = 0
  g.scale.setScalar(0)
  scene.add(g)
  return g
})

// staggered entrance
itemGroups.forEach((g, i) => {
  setTimeout(() => { g.userData.scaleTarget = 1 }, 500 + i * 130)
})

// display rack for backpacks
const rack = createRack()
addEdges(rack, 0x404055)
rack.traverse(c => { if (c.isMesh) { c.castShadow = true; c.receiveShadow = true } })
scene.add(rack)

// raycasting target list
const allMeshes = []
itemGroups.forEach(g => g.traverse(c => { if (c.isMesh) allMeshes.push(c) }))

// ─────────────────────────────────────────────────────────────
// LABELS
// ─────────────────────────────────────────────────────────────
const labelEls = itemGroups.map((g, i) => {
  const el = document.createElement('div')
  el.className = 'item-label'
  el.textContent = GEAR[i].name
  el.style.opacity = '0'
  document.body.appendChild(el)
  return el
})

function worldToScreen(pos) {
  const v = pos.clone().project(camera)
  const w = renderer.domElement.clientWidth
  const h = renderer.domElement.clientHeight
  return new THREE.Vector2((v.x + 1) / 2 * w, (-v.y + 1) / 2 * h)
}

function updateLabels() {
  itemGroups.forEach((g, i) => {
    const lp = g.position.clone()
    lp.y -= 0.5
    const sc = worldToScreen(lp)
    const el = labelEls[i]
    const isActive = hoveredItem === g || selectedItem === g
    el.style.transform = `translate(calc(${sc.x}px - 50%), calc(${sc.y}px - 50%))`
    el.style.opacity   = g.scale.x > 0.5 ? (isActive ? '1' : '0.4') : '0'
    el.style.color     = isActive ? '#a8b879' : '#ede7d5'
  })
}

// ─────────────────────────────────────────────────────────────
// PANEL
// ─────────────────────────────────────────────────────────────
const panel     = document.getElementById('gear-panel')
const pClose    = document.getElementById('panel-close')
const pTags     = document.getElementById('panel-tags')
const pName     = document.getElementById('panel-name')
const pNameEn   = document.getElementById('panel-name-en')
const pDesc     = document.getElementById('panel-desc')
const pPrice    = document.getElementById('panel-price')
const pBuy      = document.getElementById('panel-buy')
const pTips     = document.getElementById('panel-tips')

function openPanel(data) {
  pTags.innerHTML     = data.tags.map(t => `<span class="p-tag">${t}</span>`).join('')
  pName.textContent   = data.name
  pNameEn.textContent = data.nameEn
  pDesc.textContent   = data.desc
  pPrice.textContent  = data.price
  pTips.innerHTML     = data.tips.map(t => `<li>${t}</li>`).join('')
  if (data.link) {
    pBuy.href = data.link
    pBuy.style.display = 'flex'
  } else {
    pBuy.style.display = 'none'
  }
  panel.classList.add('open')
}
function closePanel() {
  panel.classList.remove('open')
  selectedItem = null
}
pClose.addEventListener('click', closePanel)

// ─────────────────────────────────────────────────────────────
// INTERACTION
// ─────────────────────────────────────────────────────────────
let hoveredItem  = null
let selectedItem = null
const raycaster  = new THREE.Raycaster()
const mouse      = new THREE.Vector2()

function hitTest(cx, cy) {
  const rect = renderer.domElement.getBoundingClientRect()
  mouse.x =  ((cx - rect.left) / rect.width)  * 2 - 1
  mouse.y = -((cy - rect.top)  / rect.height) * 2 + 1
  raycaster.setFromCamera(mouse, camera)
  const hits = raycaster.intersectObjects(allMeshes, false)
  return hits.length > 0 ? hits[0].object.userData.group : null
}

renderer.domElement.addEventListener('mousemove', e => {
  hoveredItem = hitTest(e.clientX, e.clientY)
  renderer.domElement.style.cursor = hoveredItem ? 'pointer' : 'default'
})

renderer.domElement.addEventListener('click', e => {
  const hit = hitTest(e.clientX, e.clientY)
  if (hit) {
    selectedItem = hit
    openPanel(GEAR[hit.userData.index])
  } else {
    closePanel()
  }
})

renderer.domElement.addEventListener('touchend', e => {
  const t = e.changedTouches[0]
  const hit = hitTest(t.clientX, t.clientY)
  if (hit) {
    selectedItem = hit
    openPanel(GEAR[hit.userData.index])
  } else {
    closePanel()
  }
}, { passive: true })

// ─────────────────────────────────────────────────────────────
// ANIMATION LOOP
// ─────────────────────────────────────────────────────────────
const clock = new THREE.Clock()

function animate() {
  requestAnimationFrame(animate)
  const t = clock.getElapsedTime()

  itemGroups.forEach(g => {
    // entrance scale
    const st = g.userData.scaleTarget
    if (st !== undefined) {
      const cur = g.scale.x
      const next = cur + (st - cur) * 0.09
      g.scale.setScalar(Math.abs(next - st) < 0.001 ? st : next)
    }

    // float
    const isActive = hoveredItem === g || selectedItem === g
    const floatY = (isActive ? 0.38 : 0) + Math.sin(t * 0.75 + g.userData.floatPh) * 0.07
    const targetY = BASE_POS[g.userData.index].y + floatY
    g.position.y += (targetY - g.position.y) * 0.08

    // edge color
    const eColor = isActive ? 0xa8b879 : 0x2a3f22
    if (g.userData.edgeMats) {
      g.userData.edgeMats.forEach(m => m.color.setHex(eColor))
    }
  })

  updateLabels()
  renderer.render(scene, camera)
}

// ─────────────────────────────────────────────────────────────
// RESIZE
// ─────────────────────────────────────────────────────────────
window.addEventListener('resize', () => {
  renderer.setSize(window.innerWidth, window.innerHeight)
  updateCamera()
})

animate()

// sync renderer bg with theme changes
function syncSceneBg() {
  const raw = getComputedStyle(document.documentElement).getPropertyValue('--forest-950').trim()
  if (raw) {
    const c = new THREE.Color(raw)
    renderer.setClearColor(c)
    scene.fog = new THREE.FogExp2(c.getHex(), 0.018)
  }
}
syncSceneBg()
new MutationObserver(syncSceneBg).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] })
  </script>

  <script>
    import '../scripts/theme-switcher.ts'
  </script>
</body>
</html>
