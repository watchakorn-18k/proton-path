  shelf: { x: -2.0, y: 0, z: 1.245, yaw: 0 },
}

const BASE_POS = DEFAULT_BASE_POS.map(v => v.clone())

function readSavedLayout() {
  try {
    const raw = localStorage.getItem(LAYOUT_STORAGE_KEY)
    if (!raw) return null
    const data = JSON.parse(raw)
    if (data?.version !== 1 || !Array.isArray(data.items)) return null
    return data
  } catch {
    return null
  }
}

const savedLayout = readSavedLayout()
if (savedLayout) {
  savedLayout.items.forEach((item, i) => {
    if (!BASE_POS[i] || !Number.isFinite(item?.x) || !Number.isFinite(item?.y) || !Number.isFinite(item?.z)) return
    BASE_POS[i].set(item.x, item.y, item.z)
  })
}

const itemGroups = CREATORS.map((create, i) => {
  const g = create()
  addEdges(g)
  g.traverse(c => {
    if (c.isMesh) {
      c.castShadow = true; c.receiveShadow = true
      c.userData.group = g
    }
  })
  g.position.copy(BASE_POS[i])
  if (Number.isFinite(savedLayout?.items?.[i]?.rotationY)) {
    g.rotation.y = savedLayout.items[i].rotationY
  }
  g.userData.index    = i
  g.userData.floatPh  = i * (Math.PI * 2 / CREATORS.length)
  g.userData.scaleTarget = 0
  g.scale.setScalar(0)
  scene.add(g)
  return g
})

// staggered entrance
itemGroups.forEach((g, i) => {
  setTimeout(() => { g.userData.scaleTarget = 1 }, 500 + i * 130)
})

