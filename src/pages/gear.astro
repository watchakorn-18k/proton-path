function createTent() {
  const g = new THREE.Group()

  const BODY  = 0xb7ae8e
  const DARK  = 0x2a2722
  const LITE  = 0xc7bea0
  const ACCNT = 0x8c8267
  const LINE  = 0xd9d6cb
  const METAL = 0x7d8386

  const panel = (points, color, shininess = 8) => {
    const geo = new THREE.BufferGeometry()
    geo.setAttribute('position', new THREE.Float32BufferAttribute(points.flat(), 3))
    geo.setIndex([0, 1, 2, 0, 2, 3])
    geo.computeVertexNormals()
    const mesh = new THREE.Mesh(geo, ph(color, shininess, { side: THREE.DoubleSide }))
    mesh.castShadow = true; mesh.receiveShadow = true
    return mesh
  }

  const rod = (from, to, radius, color, shininess = 30) => {
    const a = new THREE.Vector3(...from)
    const b = new THREE.Vector3(...to)
    const mid = a.clone().add(b).multiplyScalar(0.5)
    const dir = b.clone().sub(a)
    const mesh = cyl(radius, radius, dir.length(), color, 8, shininess)
    mesh.position.copy(mid)
    mesh.quaternion.setFromUnitVectors(new THREE.Vector3(0, 1, 0), dir.normalize())
