  Number.isFinite(savedLayout?.rack?.z) ? savedLayout.rack.z : DEFAULT_LAYOUT.rack.z,
)
rack.userData.center = new THREE.Vector3(0, 0, 0)
rack.userData.yaw = Number.isFinite(savedLayout?.rack?.yaw) ? savedLayout.rack.yaw : DEFAULT_LAYOUT.rack.yaw
rack.rotation.y = rack.userData.yaw
addEdges(rack, 0x404055)
rack.traverse(c => { if (c.isMesh) { c.castShadow = true; c.receiveShadow = true } })
scene.add(rack)

