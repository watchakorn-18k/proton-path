const labelEls = itemGroups.map((g, i) => {
  const el = document.createElement('div')
  el.className = 'item-label'
  el.textContent = GEAR[i].name
  el.style.opacity = '0'
  document.body.appendChild(el)
  return el
})

function worldToScreen(pos) {
  const v = pos.clone().project(camera)
  const w = renderer.domElement.clientWidth
  const h = renderer.domElement.clientHeight
  return new THREE.Vector2((v.x + 1) / 2 * w, (-v.y + 1) / 2 * h)
}

function updateLabels() {
  itemGroups.forEach((g, i) => {
    const lp = g.position.clone()
    lp.y -= 0.5
    const sc = worldToScreen(lp)
    const el = labelEls[i]
    const isActive = hoveredItem === g || selectedItem === g
    el.style.transform = `translate(calc(${sc.x}px - 50%), calc(${sc.y}px - 50%))`
    el.style.opacity   = g.scale.x > 0.5 ? (isActive ? '1' : '0.4') : '0'
    el.style.color     = isActive ? '#a8b879' : '#ede7d5'
  })
}

