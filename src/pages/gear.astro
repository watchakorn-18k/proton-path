---
import ThemeSwitcher from '../components/ThemeSwitcher.astro'
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const withBase = (p: string) => `${base}${p.startsWith('/') ? p : `/${p}`}`
---

<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="utf-8" />
  <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>อุปกรณ์เดินป่า - Proton Path</title>
  <meta name="description" content="รวมอุปกรณ์เดินป่าที่จำเป็น เลือกอย่างไร ราคาเท่าไหร่ พร้อม 3D isometric explorer คลิกที่อุปกรณ์เพื่อดูรายละเอียด" />
  <meta property="og:title" content="อุปกรณ์เดินป่า - Proton Path" />
  <meta property="og:description" content="รวมอุปกรณ์เดินป่าที่จำเป็น สำรวจแบบ 3D isometric" />
  <meta property="og:type" content="website" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bai+Jamjuree:wght@400;600;700&family=IBM+Plex+Sans+Thai:wght@400;600&display=swap" rel="stylesheet" />

  <script type="importmap" is:inline>
  {
    "imports": {
      "three": "https://cdn.jsdelivr.net/npm/three@0.175.0/build/three.module.js"
    }
  }
  </script>

  <style is:inline>
    :root, [data-theme="dark"], [data-theme="system"] {
      --forest-950: #07110d; --forest-900: #0d1a13;
      --moss: #a8b879; --bone: #ede7d5; --muted: #a8a18a;
      --line: rgb(237 231 213 / 0.14);
    }
    [data-theme="oled-dark"] {
      --forest-950: #000000; --forest-900: #0a0a0a;
      --moss: #a8b879; --bone: #ede7d5; --muted: #a8a18a;
      --line: rgb(237 231 213 / 0.12);
    }
    [data-theme="light"] {
      --forest-950: #f5f5f0; --forest-900: #ffffff;
      --moss: #6b7a3e; --bone: #1a1a1a; --muted: #5a5a4a;
      --line: rgb(26 26 26 / 0.12);
    }
    @media (prefers-color-scheme: light) {
      [data-theme="system"] {
        --forest-950: #f5f5f0; --forest-900: #ffffff;
        --moss: #6b7a3e; --bone: #1a1a1a; --muted: #5a5a4a;
        --line: rgb(26 26 26 / 0.12);
      }
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0 }

    html, body {
      width: 100%; height: 100%; overflow: hidden;
      background: var(--forest-950);
      font-family: 'Bai Jamjuree', 'IBM Plex Sans Thai', ui-sans-serif, sans-serif;
      color: var(--bone);
    }

    /* ── Navigation ── */
    .site-nav {
      position: fixed; top: 0; left: 0; right: 0; z-index: 100;
      display: flex; align-items: center; gap: 2rem;
      padding: 0.7rem 2rem;
      background: color-mix(in srgb, var(--forest-950) 88%, transparent);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--line);
    }
    .brand-mark {
      display: inline-grid;
      gap: 0;
      font-family: 'Bai Jamjuree', ui-sans-serif, sans-serif;
      font-size: 1rem;
      font-weight: 800;
      line-height: 0.9;
      letter-spacing: -0.04em;
      text-decoration: none;
    }
    .brand-mark span:first-child { color: var(--bone) }
    .brand-mark span:last-child  { color: var(--moss) }
    .site-nav nav { display: flex; gap: 1.5rem; margin-left: auto }
    .site-nav nav a {
      text-decoration: none; color: var(--muted); font-size: 0.875rem;
      transition: color 0.2s;
    }
    .site-nav nav a:hover, .site-nav nav a.active { color: var(--bone) }

    /* ── Canvas ── */
    #scene {
      position: fixed; inset: 0; display: block;
      touch-action: none;
    }

    /* ── Item labels ── */
    .item-label {
      position: fixed; top: 0; left: 0; z-index: 10;
      pointer-events: none;
      text-align: center;
      font-size: 0.7rem; font-weight: 700;
      letter-spacing: 0.1em; text-transform: uppercase;
      transition: color 0.25s, opacity 0.25s, transform 0.1s;
      white-space: nowrap;
      text-shadow: 0 1px 6px rgba(0,0,0,0.9), 0 0 12px rgba(0,0,0,0.7);
      will-change: transform;
    }

    /* ── Gear Panel ── */
    .gear-panel {
      position: fixed; top: 0; right: 0; bottom: 0; z-index: 200;
      width: 340px;
      background: color-mix(in srgb, var(--forest-900) 97%, transparent);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      border-left: 1px solid var(--line);
      padding: 5rem 1.75rem 2rem;
      overflow-y: auto;
      transform: translateX(100%);
      transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      scrollbar-width: thin;
      scrollbar-color: color-mix(in srgb, var(--moss) 30%, transparent) transparent;
    }
    .gear-panel.open { transform: translateX(0) }

    .panel-close {
      position: absolute; top: 1.1rem; right: 1.25rem;
      background: none; border: 1px solid color-mix(in srgb, var(--bone) 15%, transparent);
      border-radius: 4px; cursor: pointer; color: var(--muted);
      font-size: 0.85rem; padding: 0.3rem 0.6rem;
      transition: border-color 0.2s, color 0.2s;
    }
    .panel-close:hover { border-color: color-mix(in srgb, var(--moss) 50%, transparent); color: var(--moss) }

    .panel-tags {
      display: flex; flex-wrap: wrap; gap: 0.4rem;
      margin-bottom: 1.25rem;
    }
    .p-tag {
      font-size: 0.65rem; font-weight: 700;
      letter-spacing: 0.1em; text-transform: uppercase;
      padding: 0.25rem 0.6rem;
      border: 1px solid color-mix(in srgb, var(--moss) 35%, transparent);
      border-radius: 2px; color: var(--moss);
    }

    .panel-name {
      font-size: 1.9rem; font-weight: 700; line-height: 1.1;
      color: var(--bone); margin-bottom: 0.3rem;
    }
    .panel-name-en {
      font-size: 0.8rem; color: var(--muted);
      letter-spacing: 0.06em; margin-bottom: 1.4rem;
    }
    .panel-desc {
      font-size: 0.875rem; line-height: 1.75;
      color: var(--muted); margin-bottom: 1.5rem;
      border-left: 2px solid color-mix(in srgb, var(--moss) 30%, transparent);
      padding-left: 1rem;
    }

    .price-box {
      background: color-mix(in srgb, var(--moss) 7%, transparent);
      border: 1px solid color-mix(in srgb, var(--moss) 20%, transparent);
      border-radius: 6px; padding: 0.85rem 1rem;
      margin-bottom: 1.5rem;
      display: flex; align-items: baseline; gap: 0.6rem;
    }
    .price-label {
      font-size: 0.72rem; color: var(--muted); letter-spacing: 0.05em;
    }
    .price-value {
      font-size: 1.15rem; font-weight: 700; color: var(--moss);
    }

    .tips-heading {
      font-size: 0.68rem; font-weight: 700;
      letter-spacing: 0.12em; text-transform: uppercase;
      color: color-mix(in srgb, var(--moss) 70%, transparent); margin-bottom: 0.85rem;
    }
    .tips-list {
      list-style: none; display: flex; flex-direction: column; gap: 0.65rem;
    }
    .tips-list li {
      font-size: 0.83rem; line-height: 1.55; color: var(--muted);
      padding-left: 1.25rem; position: relative;
    }
    .tips-list li::before {
      content: '›'; position: absolute; left: 0;
      color: var(--moss); font-size: 1rem;
    }

    /* ── Buy link ── */
    .panel-buy {
      display: flex; align-items: center; gap: 0.5rem;
      padding: 0.65rem 1rem;
      background: color-mix(in srgb, var(--moss) 12%, transparent);
      border: 1px solid color-mix(in srgb, var(--moss) 35%, transparent);
      border-radius: 6px; margin-bottom: 1.25rem;
      color: var(--moss); font-size: 0.83rem; font-weight: 700;
      text-decoration: none; letter-spacing: 0.04em;
      transition: background 0.2s, border-color 0.2s;
    }
    .panel-buy:hover {
      background: color-mix(in srgb, var(--moss) 22%, transparent);
      border-color: color-mix(in srgb, var(--moss) 60%, transparent);
    }

    /* ── Divider ── */
    .panel-divider {
      height: 1px; background: var(--line);
      margin: 1.5rem 0;
    }

    /* ── Hint ── */
    .gear-hint {
      position: fixed; bottom: 1.75rem; left: 50%;
      transform: translateX(-50%);
      font-size: 0.72rem; color: color-mix(in srgb, var(--moss) 60%, transparent);
      letter-spacing: 0.12em; text-transform: uppercase;
      pointer-events: none;
      animation: hintAnim 4s ease 1.5s forwards;
      opacity: 0;
    }
    @keyframes hintAnim {
      0%   { opacity: 0; transform: translateX(-50%) translateY(4px) }
      15%  { opacity: 1; transform: translateX(-50%) translateY(0) }
      70%  { opacity: 1; transform: translateX(-50%) translateY(0) }
      100% { opacity: 0; transform: translateX(-50%) translateY(-4px) }
    }

    .scene-reset {
      position: fixed; left: 1.5rem; bottom: 1.5rem; z-index: 90;
      display: inline-flex; align-items: center; gap: 0.45rem;
      padding: 0.55rem 0.75rem;
      border: 1px solid color-mix(in srgb, var(--bone) 14%, transparent);
      border-radius: 6px;
      background: color-mix(in srgb, var(--forest-900) 86%, transparent);
      color: var(--muted);
      font: 700 0.76rem/1 'Bai Jamjuree', 'IBM Plex Sans Thai', ui-sans-serif, sans-serif;
      letter-spacing: 0.04em;
      cursor: pointer;
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      transition: border-color 0.2s, color 0.2s, background 0.2s;
    }
    .scene-reset:hover {
      border-color: color-mix(in srgb, var(--moss) 45%, transparent);
      background: color-mix(in srgb, var(--moss) 10%, var(--forest-900));
      color: var(--moss);
    }

    /* ── Responsive: mobile panel full-width from bottom ── */
    @media (max-width: 640px) {
      .gear-panel {
        top: auto; left: 0; right: 0; bottom: 0;
        width: 100%; height: 65vh;
        border-left: none;
        border-top: 1px solid var(--line);
        padding: 1.5rem 1.25rem;
        transform: translateY(100%);
      }
      .gear-panel.open { transform: translateY(0) }
      .scene-reset { left: 1rem; bottom: 1rem; }
    }

    /* ── Theme Switcher ── */
    .theme-switcher { position: relative; margin-left: 0.75rem; }
    .theme-toggle {
      display: flex; align-items: center; gap: 0.5rem;
      padding: 0.4rem 0.6rem; border: 1px solid var(--line);
      border-radius: 0.375rem; background: transparent; color: var(--bone);
      font-family: 'Bai Jamjuree', ui-sans-serif, sans-serif;
      font-size: 0.9rem; cursor: pointer;
      transition: border-color 180ms, background-color 180ms;
    }
    .theme-toggle:hover {
      border-color: color-mix(in srgb, var(--moss) 35%, transparent);
      background: color-mix(in srgb, var(--moss) 5%, transparent);
    }
    .theme-icon { display: flex; width: 1.1rem; height: 1.1rem; align-items: center; justify-content: center; }
    .theme-menu {
      position: absolute; top: calc(100% + 0.5rem); right: 0; z-index: 300;
      min-width: 11rem; border: 1px solid var(--line); border-radius: 0.5rem;
      background: var(--forest-900);
      box-shadow: 0 8px 24px color-mix(in srgb, var(--forest-950) 40%, transparent);
      opacity: 0; visibility: hidden; transform: translateY(-8px);
      transition: opacity 180ms, transform 180ms, visibility 180ms;
    }
    .theme-menu[data-open="true"] { opacity: 1; visibility: visible; transform: translateY(0); }
    .theme-menu button {
      display: flex; align-items: center; gap: 0.75rem;
      width: 100%; padding: 0.75rem 1rem 0.75rem 2.25rem;
      border: 0; border-top: 1px solid var(--line);
      background: transparent; color: var(--muted);
      font-family: 'Bai Jamjuree', ui-sans-serif, sans-serif;
      font-size: 0.875rem; text-align: left; cursor: pointer; position: relative;
      transition: background-color 180ms, color 180ms;
    }
    .theme-menu button:first-child { border-top: 0; border-radius: 0.5rem 0.5rem 0 0; }
    .theme-menu button:last-child  { border-radius: 0 0 0.5rem 0.5rem; }
    .theme-menu button:hover { background: color-mix(in srgb, var(--moss) 10%, transparent); color: var(--bone); }
    .theme-menu button[data-active="true"] { color: var(--moss); font-weight: 700; background: color-mix(in srgb, var(--moss) 12%, transparent); }
    .theme-menu button[data-active="true"]::before { content: '✓'; position: absolute; left: 0.75rem; color: var(--moss); }
  </style>
</head>

<body>
  <canvas id="scene"></canvas>

  <header class="site-nav">
    <a class="brand-mark" href={withBase('/')} aria-label="Proton Path home">
      <span>Proton</span><span>◄ Path</span>
    </a>
    <nav aria-label="Primary navigation">
      <a href={withBase('/#video')}>คลิปล่าสุด</a>
      <a href={withBase('/#route')}>เส้นทาง</a>
      <a href={withBase('/blog/')}>บล็อก</a>
      <a href={withBase('/gear/')} class="active">อุปกรณ์</a>
    </nav>
    <ThemeSwitcher />
  </header>

  <div class="gear-panel" id="gear-panel">
    <button class="panel-close" id="panel-close">✕ ปิด</button>
    <div class="panel-tags" id="panel-tags"></div>
    <h2 class="panel-name" id="panel-name"></h2>
    <p class="panel-name-en" id="panel-name-en"></p>
    <p class="panel-desc" id="panel-desc"></p>
    <div class="price-box">
      <span class="price-label">ราคาประมาณ</span>
      <span class="price-value" id="panel-price"></span>
    </div>
    <a class="panel-buy" id="panel-buy" href="#" target="_blank" rel="noopener noreferrer" style="display:none">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
      ซื้อได้ที่ Shopee
    </a>
    <div class="panel-divider"></div>
    <p class="tips-heading">Tips ก่อนซื้อ</p>
    <ul class="tips-list" id="panel-tips"></ul>
  </div>

  <p class="gear-hint">คลิกที่อุปกรณ์เพื่อดูรายละเอียด</p>
  <button class="scene-reset" id="scene-reset" type="button" aria-label="รีเซ็ตตำแหน่งอุปกรณ์">↺ รีเซ็ต</button>

  <script type="module" is:inline>
import * as THREE from 'three'

// ─────────────────────────────────────────────────────────────
// GEAR DATA
// ─────────────────────────────────────────────────────────────
const GEAR = [
  {
    name: 'เป้สะพายหลัง Gregory Zulu 55L',
    nameEn: 'Gregory Zulu 55L',
    tags: ['จำเป็นมาก', 'ค้างคืน', '55L'],
    price: '~12,805 ฿',
    desc: 'Gregory Zulu 55 เป้เดินป่าระดับ premium ที่ใช้จริงในทริปนี้ ระบบหลัง Float-On-Air™ Suspension รับน้ำหนักได้ดีและระบายความร้อนแม้เดินชัน hip belt นุ่ม กระจายน้ำหนักลงสะโพกได้จริง ขนาด 55L พอดีกับการเดิน 3–5 วัน',
    tips: ['Hip belt รัดที่ยอดกระดูกสะโพก ไม่ใช่เอว', 'ปรับ torso length ก่อนใส่จริงทุกครั้ง', 'มีช่อง hydration sleeve ด้านในและ trekking pole attachment'],
    link: 'https://s.shopee.co.th/9pcHeUSTgY',
  },
  {
    name: 'Naturehike Cloud Up Pro เต็นท์ 2 คน',
    nameEn: 'Naturehike Cloud Up Pro 2P Tent',
    tags: ['ค้างคืน', 'PU3000+', '20D'],
    price: '฿7,745',
    desc: 'Naturehike Cloud Up Pro เต็นท์เดินป่า 2 คน ผ้า 20D กันน้ำ PU3000+ ทรง low-profile น้ำหนักเบา มีฟลายชีทสี moon rock sand พื้นดำแบบ bathtub floor และ vestibule ด้านหน้าสำหรับวางรองเท้าหรือเป้เล็ก',
    tips: ['กาง flysheet ให้ตึงเพื่อให้หยดฝนไหลออกจากผ้า', 'ใช้ guy line ทุกจุดเมื่อเจอลมแรงหรือฝนหนัก', 'ผึ่งให้แห้งก่อนเก็บเพื่อลดกลิ่นอับและยืดอายุ seam tape'],
    link: 'https://s.shopee.co.th/4fuBYC7q8v',
  },
  {
    name: 'ถุงน้ำวิ่งเทรลพกพา',
    nameEn: 'Trail Running Hydration Bladder',
    tags: ['จำเป็นมาก', 'วิ่งเทรล', 'น้ำหนักเบา'],
    price: '฿109',
    desc: 'ถุงน้ำพกพาสำหรับใส่ในเป้วิ่งเทรลหรือกระเป๋าเดินป่า ใช้เติมน้ำแล้วต่อสายดูดออกมาด้านหน้า ช่วยจิบน้ำระหว่างเดินป่า วิ่งเทรล หรือมาราธอนได้สะดวกโดยไม่ต้องหยิบขวดบ่อย',
    tips: ['ล้างและผึ่งให้แห้งหลังใช้ทุกครั้ง', 'ทดสอบรอยรั่วก่อนใส่ในกระเป๋า', 'เติมน้ำไม่เต็มสุดเพื่อให้ถุงยืดตัวและใส่เป้ได้ง่าย'],
    link: 'https://s.shopee.co.th/5AqS9jymA5',
  },
  {
    name: 'CRX ไฟฉายคาดหัว Outdoor USB Rechargeable',
    nameEn: 'CRX USB Rechargeable Headlight /101',
    tags: ['จำเป็นมาก', 'USB', 'แม่เหล็ก'],
    price: '฿30',
    desc: 'CRX ไฟฉายคาดหัว Outdoor รุ่น /101 ชาร์จไฟ USB ได้ มีไฟหน้าแบบเลนส์กลมและแถบ COB สำหรับส่องกว้าง สายคาดหัวสีดำปรับขนาดได้ เหมาะเป็นไฟสำรองราคาประหยัดสำหรับเดินป่า แคมป์ หรือใช้งานฉุกเฉิน',
    tips: ['ชาร์จให้เต็มก่อนออกทริป เพราะแบตรุ่นเล็กราคาประหยัดหมดไว', 'พกไฟสำรองอีกดวงเมื่อเดินกลางคืนจริง', 'เก็บพอร์ต USB ให้แห้งและหลีกเลี่ยงฝนหนักโดยตรง'],
    link: 'https://s.shopee.co.th/AKYYJ0cAXR',
  },
  {
    name: 'Naturehike ST01 ไม้เท้าเดินป่า',
    nameEn: 'Naturehike ST01 Trekking Pole',
    tags: ['แนะนำ', 'ทางชัน', 'น้ำหนักเบา'],
    price: '฿322',
    desc: 'Naturehike ST01 คันเดินป่าอลูมิเนียม น้ำหนัก 235g/คัน ปรับความยาวได้ 61–135cm ระบบ quick-lock Nylon ด้ามจับ EVA ปลาย Steel ช่วยลดแรงกระแทกที่เข่าบนทางชันลงและเพิ่มความสมดุลบนหินลื่น เหมาะสำหรับผู้ใหญ่และเด็ก',
    tips: ['ปรับความยาว: ข้อศอกงอ 90° เมื่อเดินราบ', 'Nylon quick-lock: บิดล็อกให้แน่นก่อนใช้ทุกครั้ง', 'ถอดหัวกระเด็นแล้วใส่ Snow basket ได้ตามสภาพเส้นทาง'],
    link: 'https://s.shopee.co.th/LlCMPCmpY',
  },
  {
    name: 'Lixada ถุงนอนซองจดหมาย',
    nameEn: 'Lixada Envelope Sleeping Bag',
