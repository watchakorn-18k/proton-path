const resetBtn  = document.getElementById('scene-reset')
const pTags     = document.getElementById('panel-tags')
const pName     = document.getElementById('panel-name')
const pNameEn   = document.getElementById('panel-name-en')
const pDesc     = document.getElementById('panel-desc')
const pPrice    = document.getElementById('panel-price')
const pBuy      = document.getElementById('panel-buy')
const pTips     = document.getElementById('panel-tips')

function openPanel(data) {
  pTags.innerHTML     = data.tags.map(t => `<span class="p-tag">${t}</span>`).join('')
  pName.textContent   = data.name
  pNameEn.textContent = data.nameEn
  pDesc.textContent   = data.desc
  pPrice.textContent  = data.price
  pTips.innerHTML     = data.tips.map(t => `<li>${t}</li>`).join('')
  if (data.link) {
    pBuy.href = data.link
    pBuy.style.display = 'flex'
  } else {
    pBuy.style.display = 'none'
  }
  panel.classList.add('open')
}
function closePanel() {
  panel.classList.remove('open')
  selectedItem = null
}
pClose.addEventListener('click', closePanel)

function saveLayout() {
  const data = {
    version: 1,
    items: itemGroups.map(g => {
      const i = g.userData.index
      return {
        x: BASE_POS[i].x,
        y: BASE_POS[i].y,
        z: BASE_POS[i].z,
        rotationY: g.rotation.y,
      }
    }),
    rack: {
      x: rack.position.x,
      y: rack.position.y,
      z: rack.position.z,
      yaw: rack.userData.yaw ?? rack.rotation.y,
    },
    shelf: {
      x: shelf.position.x,
      y: shelf.position.y,
      z: shelf.position.z,
      yaw: shelf.userData.yaw ?? shelf.rotation.y,
    },
  }

  try {
    localStorage.setItem(LAYOUT_STORAGE_KEY, JSON.stringify(data))
  } catch {
    // Storage can be unavailable in private modes; the scene remains usable.
  }
}

function resetLayout() {
  try {
    localStorage.removeItem(LAYOUT_STORAGE_KEY)
  } catch {}

  DEFAULT_BASE_POS.forEach((pos, i) => {
    BASE_POS[i].copy(pos)
    itemGroups[i].position.copy(pos)
    itemGroups[i].rotation.set(0, 0, 0)
  })

  rack.position.set(DEFAULT_LAYOUT.rack.x, DEFAULT_LAYOUT.rack.y, DEFAULT_LAYOUT.rack.z)
  rack.rotation.y = DEFAULT_LAYOUT.rack.yaw
  rack.userData.yaw = DEFAULT_LAYOUT.rack.yaw

  shelf.position.set(DEFAULT_LAYOUT.shelf.x, DEFAULT_LAYOUT.shelf.y, DEFAULT_LAYOUT.shelf.z)
  shelf.rotation.y = DEFAULT_LAYOUT.shelf.yaw
  shelf.userData.yaw = DEFAULT_LAYOUT.shelf.yaw

  snapDefaultItems()
  closePanel()
}

resetBtn.addEventListener('click', e => {
  e.stopPropagation()
  resetLayout()
})

// ─────────────────────────────────────────────────────────────
// INTERACTION
// ─────────────────────────────────────────────────────────────
let hoveredItem  = null
let selectedItem = null
const raycaster  = new THREE.Raycaster()
const mouse      = new THREE.Vector2()
const dragPlane  = new THREE.Plane(new THREE.Vector3(0, 1, 0), 0)
const dragPoint  = new THREE.Vector3()
const dragOffset = new THREE.Vector3()
let pointerItem  = null
let draggedItem  = null
let pointerRack  = false
let draggedRack  = false
let rackDragItems = []
let pointerShelf = false
let draggedShelf = false
let shelfDragItems = []
let pointerBaseY = 0
let itemPlaneFreed = false
let dragMoved    = false
let pointerStartX = 0
let pointerStartY = 0
let lastTapKey = null
let lastTapAt = 0

function hitTest(cx, cy) {
  const rect = renderer.domElement.getBoundingClientRect()
  mouse.x =  ((cx - rect.left) / rect.width)  * 2 - 1
  mouse.y = -((cy - rect.top)  / rect.height) * 2 + 1
  raycaster.setFromCamera(mouse, camera)
  const hits = raycaster.intersectObjects(allMeshes, false)
  return hits.length > 0 ? hits[0].object.userData.group : null
}

function hitShelf(cx, cy) {
  const rect = renderer.domElement.getBoundingClientRect()
  mouse.x =  ((cx - rect.left) / rect.width)  * 2 - 1
  mouse.y = -((cy - rect.top)  / rect.height) * 2 + 1
  raycaster.setFromCamera(mouse, camera)
  return raycaster.intersectObjects(shelfMeshes, false).length > 0
}

function hitRack(cx, cy) {
  const rect = renderer.domElement.getBoundingClientRect()
  mouse.x =  ((cx - rect.left) / rect.width)  * 2 - 1
  mouse.y = -((cy - rect.top)  / rect.height) * 2 + 1
  raycaster.setFromCamera(mouse, camera)
  return raycaster.intersectObjects(rackMeshes, false).length > 0
}

function isItemOnShelf(g) {
  const local = localXZ(g, shelf)
  const x = local.x
  const z = local.z
  return x >= -1.95 && x <= 1.95 && z >= -0.425 && z <= 0.435
}

function isItemOnRack(g) {
  const local = localXZ(g, rack)
  const x = local.x
  const z = local.z
  return g.position.y > 0.45 && x >= -2.2 && x <= 2.2 && z >= -0.25 && z <= 0.55
}

function inSoftBounds(local, minX, maxX, minZ, maxZ, margin = 0.34) {
  return (
    local.x >= minX - margin && local.x <= maxX + margin &&
    local.z >= minZ - margin && local.z <= maxZ + margin
  )
}

function localXZ(g, parent) {
  const center = propCenter(parent)
  const dx = g.position.x - center.x
  const dz = g.position.z - center.z
  const a = -(parent.userData.yaw ?? parent.rotation.y)
  return {
    x: dx * Math.cos(a) - dz * Math.sin(a),
    z: dx * Math.sin(a) + dz * Math.cos(a),
  }
}

function worldFromLocalXZ(parent, x, z) {
  const center = propCenter(parent)
  const a = parent.userData.yaw ?? parent.rotation.y
  return {
    x: center.x + x * Math.cos(a) - z * Math.sin(a),
    z: center.z + x * Math.sin(a) + z * Math.cos(a),
  }
}

function propCenter(parent) {
  const center = parent.userData.center ?? new THREE.Vector3()
  return {
    x: parent.position.x + center.x,
    z: parent.position.z + center.z,
  }
}

function rotatePropInPlace(parent, angle) {
  parent.rotation.y += angle
  parent.userData.yaw = parent.rotation.y
}

function propAxisHalfSize(parent, footprint) {
  const a = parent.userData.yaw ?? parent.rotation.y
  const cos = Math.abs(Math.cos(a))
  const sin = Math.abs(Math.sin(a))
  return {
    x: footprint.halfX * cos + footprint.halfZ * sin,
    z: footprint.halfX * sin + footprint.halfZ * cos,
  }
}

function clampPropToPlatform(parent, footprint, x, z) {
  const half = propAxisHalfSize(parent, footprint)
  return {
    x: THREE.MathUtils.clamp(x, PLATFORM_BOUNDS.minX + half.x, PLATFORM_BOUNDS.maxX - half.x),
    z: THREE.MathUtils.clamp(z, PLATFORM_BOUNDS.minZ + half.z, PLATFORM_BOUNDS.maxZ - half.z),
  }
}

function setItemBaseXZ(g, x, z) {
  g.position.x = x
  g.position.z = z
  BASE_POS[g.userData.index].x = x
  BASE_POS[g.userData.index].z = z
}

function closestSlot(local, slots) {
  return slots.reduce((best, slot) => {
    const d = (local.x - slot.x) ** 2 + (local.z - slot.z) ** 2
    return d < best.d ? { slot, d } : best
  }, { slot: slots[0], d: Infinity }).slot
}

function shelfDropLevel(cx, cy) {
  const rect = renderer.domElement.getBoundingClientRect()
  mouse.x =  ((cx - rect.left) / rect.width)  * 2 - 1
  mouse.y = -((cy - rect.top)  / rect.height) * 2 + 1
  raycaster.setFromCamera(mouse, camera)
  const hits = raycaster.intersectObjects(shelfMeshes, false)
  if (!hits.length) return null
  shelfHitPoint.copy(hits[0].point)
  return shelfHitPoint.y - shelf.position.y > 0.45 ? 0.75 : 0
}

function snapItemToShelf(g, level = null, preferHome = true) {
  const local = localXZ(g, shelf)
  if (!inSoftBounds(local, -1.95, 1.95, -0.425, 0.435)) return false

  const homeSlot = SHELF_HOME_SLOT.get(g.userData.index)
  let slots = SHELF_SLOTS
  if (level !== null) {
    slots = SHELF_SLOTS.filter(slot => slot.y === level)
  }
  const slot = preferHome && homeSlot !== undefined ? SHELF_SLOTS[homeSlot] : closestSlot(local, slots)
  const snapped = worldFromLocalXZ(shelf, slot.x, slot.z)
  setItemBaseXZ(g, snapped.x, snapped.z)
  BASE_POS[g.userData.index].y = slot.y
  return true
}

function snapItemToRack(g) {
  if (g.userData.index !== 0 && g.userData.index !== 7) return false

  const local = localXZ(g, rack)
  if (!inSoftBounds(local, -2.2, 2.2, -0.25, 0.55)) return false

  const slot = RACK_SLOTS[RACK_HOME_SLOT.get(g.userData.index)]
  const snapped = worldFromLocalXZ(rack, slot.x, slot.z)
  setItemBaseXZ(g, snapped.x, snapped.z)
  BASE_POS[g.userData.index].y = slot.y
  return true
}

function snapDraggedItem(g, e) {
  if (!g) return
  if (snapItemToRack(g)) return
  const level = e ? shelfDropLevel(e.clientX, e.clientY) : 0
  const shelfLevel = level ?? 0
  if (snapItemToShelf(g, shelfLevel, false)) return
  setItemBaseXZ(g, g.position.x, g.position.z)
  BASE_POS[g.userData.index].y = 0
}

function rotateItemAround(g, origin, angle) {
  const dx = g.position.x - origin.x
  const dz = g.position.z - origin.z
  const cos = Math.cos(angle)
  const sin = Math.sin(angle)
  const nextX = origin.x + dx * cos - dz * sin
  const nextZ = origin.z + dx * sin + dz * cos
  g.position.x = nextX
  g.position.z = nextZ
  g.rotation.y += angle
  BASE_POS[g.userData.index].x = nextX
  BASE_POS[g.userData.index].z = nextZ
}

function rotateTarget(hit, wasRack, wasShelf) {
  const angle = Math.PI / 4
  if (hit) {
    hit.rotation.y += angle
    saveLayout()
    return
  }
  if (wasRack) {
    const carriedItems = itemGroups.filter(isItemOnRack)
    const origin = propCenter(rack)
    rotatePropInPlace(rack, angle)
    carriedItems.forEach(g => rotateItemAround(g, origin, angle))
    saveLayout()
    return
  }
  if (wasShelf) {
    const carriedItems = itemGroups.filter(isItemOnShelf)
    const origin = propCenter(shelf)
    rotatePropInPlace(shelf, angle)
    carriedItems.forEach(g => rotateItemAround(g, origin, angle))
    saveLayout()
  }
}

function isDoubleTap(key) {
  const now = performance.now()
  const matched = key === lastTapKey && now - lastTapAt < 320
  lastTapKey = key
  lastTapAt = now
  return matched
}

function pointerToDragPoint(cx, cy, y) {
  const rect = renderer.domElement.getBoundingClientRect()
  mouse.x =  ((cx - rect.left) / rect.width)  * 2 - 1
  mouse.y = -((cy - rect.top)  / rect.height) * 2 + 1
  raycaster.setFromCamera(mouse, camera)
  dragPlane.constant = -y
  return raycaster.ray.intersectPlane(dragPlane, dragPoint)
}

function moveDraggedItem(e) {
  if (!draggedItem) return
  if (dragMoved && !itemPlaneFreed) {
    const floorPoint = pointerToDragPoint(e.clientX, e.clientY, 0)
    if (!floorPoint) return
    BASE_POS[draggedItem.userData.index].y = 0
    dragOffset.set(draggedItem.position.x - floorPoint.x, 0, draggedItem.position.z - floorPoint.z)
    itemPlaneFreed = true
  }
  const p = pointerToDragPoint(e.clientX, e.clientY, BASE_POS[draggedItem.userData.index].y)
  if (!p) return
  draggedItem.position.x = THREE.MathUtils.clamp(p.x + dragOffset.x, -6.2, 5.2)
  draggedItem.position.z = THREE.MathUtils.clamp(p.z + dragOffset.z, -2.4, 2.4)
}

function moveDraggedShelf(e) {
  if (!draggedShelf) return
  const p = pointerToDragPoint(e.clientX, e.clientY, 0)
  if (!p) return

  const next = clampPropToPlatform(shelf, PROP_FOOTPRINTS.shelf, p.x + dragOffset.x, p.z + dragOffset.z)
  const nextX = next.x
  const nextZ = next.z
  const dx = nextX - shelf.position.x
  const dz = nextZ - shelf.position.z
  shelf.position.x = nextX
  shelf.position.z = nextZ

  shelfDragItems.forEach(g => {
    g.position.x += dx
    g.position.z += dz
    BASE_POS[g.userData.index].x += dx
    BASE_POS[g.userData.index].z += dz
  })
}

function moveDraggedRack(e) {
  if (!draggedRack) return
  const p = pointerToDragPoint(e.clientX, e.clientY, 0)
  if (!p) return

  const next = clampPropToPlatform(rack, PROP_FOOTPRINTS.rack, p.x + dragOffset.x, p.z + dragOffset.z)
  const nextX = next.x
  const nextZ = next.z
  const dx = nextX - rack.position.x
  const dz = nextZ - rack.position.z
  rack.position.x = nextX
  rack.position.z = nextZ

  rackDragItems.forEach(g => {
    g.position.x += dx
    g.position.z += dz
    BASE_POS[g.userData.index].x += dx
    BASE_POS[g.userData.index].z += dz
  })
}

function snapDefaultItems() {
  itemGroups.forEach(g => {
    if (isItemOnRack(g)) {
      snapItemToRack(g)
    } else if (isItemOnShelf(g)) {
      snapItemToShelf(g)
    }
  })
}

if (!savedLayout) {
  snapDefaultItems()
}

renderer.domElement.addEventListener('pointerdown', e => {
  pointerItem = hitTest(e.clientX, e.clientY)
  pointerRack = !pointerItem && hitRack(e.clientX, e.clientY)
  pointerShelf = !pointerItem && hitShelf(e.clientX, e.clientY)
  pointerBaseY = 0
  itemPlaneFreed = false
  pointerStartX = e.clientX
  pointerStartY = e.clientY
  dragMoved = false
  if (!pointerItem && !pointerRack && !pointerShelf) return

  const baseY = pointerItem ? BASE_POS[pointerItem.userData.index].y : 0
  const p = pointerToDragPoint(e.clientX, e.clientY, baseY)
  if (!p) return
  if (pointerItem) {
    draggedItem = pointerItem
    pointerBaseY = BASE_POS[draggedItem.userData.index].y
    dragOffset.set(draggedItem.position.x - p.x, 0, draggedItem.position.z - p.z)
  } else if (pointerRack) {
    draggedRack = true
    rackDragItems = itemGroups.filter(isItemOnRack)
    dragOffset.set(rack.position.x - p.x, 0, rack.position.z - p.z)
  } else {
    draggedShelf = true
    shelfDragItems = itemGroups.filter(isItemOnShelf)
    dragOffset.set(shelf.position.x - p.x, 0, shelf.position.z - p.z)
  }
  renderer.domElement.setPointerCapture(e.pointerId)
  renderer.domElement.style.cursor = 'grabbing'
  e.preventDefault()
})

renderer.domElement.addEventListener('pointermove', e => {
  if (draggedItem || draggedRack || draggedShelf) {
    const dx = e.clientX - pointerStartX
    const dy = e.clientY - pointerStartY
    dragMoved = dragMoved || (dx * dx + dy * dy > 16)
    moveDraggedItem(e)
    moveDraggedRack(e)
    moveDraggedShelf(e)
    return
  }
  hoveredItem = hitTest(e.clientX, e.clientY)
  renderer.domElement.style.cursor = hoveredItem || hitRack(e.clientX, e.clientY) || hitShelf(e.clientX, e.clientY) ? 'grab' : 'default'
})

renderer.domElement.addEventListener('pointerup', e => {
  const wasDragged = dragMoved
  const hit = pointerItem
  const wasRack = pointerRack
  const wasShelf = pointerShelf
  const releasedItem = draggedItem
  if ((draggedItem || draggedRack || draggedShelf) && renderer.domElement.hasPointerCapture(e.pointerId)) {
    renderer.domElement.releasePointerCapture(e.pointerId)
  }
  draggedItem = null
  draggedRack = false
  draggedShelf = false
  pointerItem = null
  pointerRack = false
  pointerShelf = false
  rackDragItems = []
  shelfDragItems = []
  dragMoved = false

  if (wasDragged) {
    snapDraggedItem(releasedItem, e)
    saveLayout()
    hoveredItem = hitTest(e.clientX, e.clientY)
    renderer.domElement.style.cursor = hoveredItem || hitRack(e.clientX, e.clientY) || hitShelf(e.clientX, e.clientY) ? 'grab' : 'default'
  } else if (hit) {
    BASE_POS[hit.userData.index].y = pointerBaseY
    const key = `item-${hit.userData.index}`
    if (isDoubleTap(key)) {
      rotateTarget(hit, false, false)
    } else {
      selectedItem = hit
      openPanel(GEAR[hit.userData.index])
    }
  } else if (wasRack || wasShelf) {
    const key = wasRack ? 'rack' : 'shelf'
    if (isDoubleTap(key)) rotateTarget(null, wasRack, wasShelf)
  } else {
    closePanel()
  }
  pointerBaseY = 0
  itemPlaneFreed = false
})

renderer.domElement.addEventListener('pointercancel', e => {
  const canceledItem = draggedItem
  if ((draggedItem || draggedRack || draggedShelf) && renderer.domElement.hasPointerCapture(e.pointerId)) {
    renderer.domElement.releasePointerCapture(e.pointerId)
  }
  if (canceledItem) {
    BASE_POS[canceledItem.userData.index].y = pointerBaseY
  }
  draggedItem = null
  draggedRack = false
  draggedShelf = false
  pointerItem = null
  pointerRack = false
  pointerShelf = false
  rackDragItems = []
  shelfDragItems = []
  pointerBaseY = 0
  itemPlaneFreed = false
  dragMoved = false
  renderer.domElement.style.cursor = hoveredItem || hitRack(e.clientX, e.clientY) || hitShelf(e.clientX, e.clientY) ? 'grab' : 'default'
})

// ─────────────────────────────────────────────────────────────
// ANIMATION LOOP
// ─────────────────────────────────────────────────────────────
const clock = new THREE.Clock()

function animate() {
  requestAnimationFrame(animate)
  const t = clock.getElapsedTime()

  itemGroups.forEach(g => {
    // entrance scale
    const st = g.userData.scaleTarget
    if (st !== undefined) {
      const cur = g.scale.x
      const targetScale = st * (g.userData.displayScale ?? 1)
      const next = cur + (targetScale - cur) * 0.09
      g.scale.setScalar(Math.abs(next - targetScale) < 0.001 ? targetScale : next)
    }

    // float
    const isActive = hoveredItem === g || selectedItem === g
    const floatY = (isActive ? 0.38 : 0) + Math.sin(t * 0.75 + g.userData.floatPh) * 0.07
    const targetY = BASE_POS[g.userData.index].y + floatY
    g.position.y += (targetY - g.position.y) * 0.08

    // edge color
    const eColor = isActive ? 0xa8b879 : 0x2a3f22
    if (g.userData.edgeMats) {
      g.userData.edgeMats.forEach(m => m.color.setHex(eColor))
    }
  })

  updateLabels()
  renderer.render(scene, camera)
}

// ─────────────────────────────────────────────────────────────
// RESIZE
// ─────────────────────────────────────────────────────────────
window.addEventListener('resize', () => {
  renderer.setSize(window.innerWidth, window.innerHeight)
  updateCamera()
})

animate()

// sync renderer bg with theme changes
function syncSceneBg() {
  const raw = getComputedStyle(document.documentElement).getPropertyValue('--forest-950').trim()
  if (raw) {
    const c = new THREE.Color(raw)
    renderer.setClearColor(c)
    scene.fog = new THREE.FogExp2(c.getHex(), 0.018)
  }
}
syncSceneBg()
new MutationObserver(syncSceneBg).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] })
  </script>

  <script>
    import '../scripts/theme-switcher.ts'
  </script>
