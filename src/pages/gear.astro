// ─────────────────────────────────────────────────────────────
// HELPERS
// ─────────────────────────────────────────────────────────────
function ph(color, shininess = 20, extra = {}) {
  return new THREE.MeshPhongMaterial({ color, shininess, ...extra })
}
function box(w, h, d, color, shininess = 20, extra = {}) {
  const m = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), ph(color, shininess, extra))
  m.castShadow = true; m.receiveShadow = true
  return m
}
function cyl(rt, rb, h, color, segs = 12, shininess = 20, extra = {}) {
  const m = new THREE.Mesh(new THREE.CylinderGeometry(rt, rb, h, segs), ph(color, shininess, extra))
  m.castShadow = true; m.receiveShadow = true
  return m
}

function addEdges(group, defaultColor = 0x2a3f22) {
  const mats = []
  group.traverse(c => {
    if (c.isMesh && c.geometry.type === 'BoxGeometry') {
      const mat = new THREE.LineBasicMaterial({ color: defaultColor })
      c.add(new THREE.LineSegments(new THREE.EdgesGeometry(c.geometry), mat))
      mats.push(mat)
    }
  })
  group.userData.edgeMats = mats
}

// ─────────────────────────────────────────────────────────────
// PLATFORM
// ─────────────────────────────────────────────────────────────
;(function buildPlatform() {
  const cols = 9, rows = 4
  const tSize = 1.55, tH = 0.14, gap = 0.06, step = tSize + gap
  const ox = -(cols - 1) * step / 2
  const oz = -(rows - 1) * step / 2
  for (let c = 0; c < cols; c++) {
    for (let r = 0; r < rows; r++) {
      const alt = (c + r) % 2
      const geo = new THREE.BoxGeometry(tSize, tH, tSize)
      const mat = new THREE.MeshPhongMaterial({ color: alt ? 0x0d1a13 : 0x0b1810, shininess: 4 })
      const tile = new THREE.Mesh(geo, mat)
      tile.position.set(ox + c * step, -tH / 2, oz + r * step)
      tile.receiveShadow = true
      scene.add(tile)
      // subtle tile edge
      const el = new THREE.LineSegments(
        new THREE.EdgesGeometry(geo),
        new THREE.LineBasicMaterial({ color: 0x162614, transparent: true, opacity: 0.7 })
      )
      tile.add(el)
    }
  }
})()

